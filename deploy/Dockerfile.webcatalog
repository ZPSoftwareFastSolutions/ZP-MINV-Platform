FROM node:20-alpine AS builder

WORKDIR /app

# Copiar el código fuente de WebCatalog
COPY ["src/3. Presentation/MINV.WebCatalog/", "."]

# Instalar dependencias y construir para producción
RUN npm install
RUN npm run build

# Servidor web ligero para servir los archivos estáticos
FROM nginx:alpine

# Copiar los archivos estáticos desde el paso anterior
COPY --from=builder /app/dist /usr/share/nginx/html

# Configuración básica para soportar React Router (SPA)
RUN echo 'server { listen 80; location / { root /usr/share/nginx/html; try_files $uri /index.html; } }' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
