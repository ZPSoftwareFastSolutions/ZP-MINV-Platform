# M-INV V6 · Catálogo web (MINV.WebCatalog): build de Vite + nginx que sirve la web y reenvía /storefront/ al API Gateway.
FROM node:20-alpine AS builder

WORKDIR /app

# URL del API Gateway que usará el navegador (Vite la incrusta al construir); «/» = mismo origen (nginx reenvía /storefront/)
ARG VITE_API_URL=/
ENV VITE_API_URL=$VITE_API_URL

# Dependencias primero (capa en caché mientras no cambie package-lock.json)
COPY ["src/3. Presentation/MINV.WebCatalog/package.json", "src/3. Presentation/MINV.WebCatalog/package-lock.json", "./"]
RUN npm ci

# Código de la web y build de producción
COPY ["src/3. Presentation/MINV.WebCatalog/", "."]
RUN npm run build

# Servidor web ligero para los archivos estáticos y el proxy de la API de tienda
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx.webcatalog.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
