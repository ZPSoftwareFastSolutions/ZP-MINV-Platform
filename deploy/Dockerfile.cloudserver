# M-INV V4/V4.1 · Servidor en la nube del escritorio (MINV.CloudServer)
# Construcción: docker build -f deploy/Dockerfile.cloudserver -t minv-cloudserver:4.1.0-alpha.1 .
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish "src/3. Presentation/MINV.CloudServer/MINV.CloudServer.csproj" -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .
# Sin privilegios de root dentro del contenedor
USER app
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1
EXPOSE 8080
# Salud real del servidor: GET /api/v1/health por TCP con bash (la imagen aspnet no trae curl ni wget). Antes se ejecutaba
# «dotnet MINV.CloudServer.dll --version», que intentaba levantar un segundo servidor en el mismo puerto y quedaba «unhealthy».
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080 && printf 'GET /api/v1/health HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200 '"]
ENTRYPOINT ["dotnet", "MINV.CloudServer.dll"]
