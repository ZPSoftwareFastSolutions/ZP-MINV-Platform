# M-INV V4/V4.1/V6/V7 · variables de los servidores (copie a deploy/.env; NUNCA versione deploy/.env).
# Cadena del rol minv_server (sin BYPASSRLS, no dueño de las tablas) con TLS verificado:
MINV_DB=Host=<servidor>;Port=25060;Database=minv;Username=minv_server;Password=<clave>;SSL Mode=VerifyFull;Root Certificate=/certs/ca.crt
# Réplica de lectura para el modelo de reportes (opcional; vacío = la misma base):
MINV_DB_READ=
# Claves maestras AES-256 de los secretos de webhooks y del token delegado del SIN: id:base64(32 bytes)[;id2:...]
# (la primera es la vigente; al rotar, deje la anterior después para poder descifrar lo ya guardado)
MINV_INTEGRATION_KEYS=nube1:<base64 de 32 bytes>
# V4.1 · Trabajo automático de la facturación SIAT en el servidor en la nube (envío, recuperación, CUFD del día): true/false
MINV_SIAT_BACKGROUND=true
# V4.1 · Solo para el perfil siat-simulador (ensayos): token de SIMULACIÓN que acepta el simulador del SIN
# (el MINV_SIAT_TOKEN de %LOCALAPPDATA%\M-INV\claves-integracion.txt de la carga de prueba; vacío = cualquiera de prueba).
# El token REAL del SIN nunca va aquí: se carga cifrado en Configuración › Facturación SIAT del escritorio.
MINV_SIAT_TOKEN=
# Solo para el perfil local-db (PostgreSQL de ensayo en un contenedor):
POSTGRES_PASSWORD=<clave de ensayo>
# V6 · Tienda web pública del API Gateway (/storefront/v1, sin llave) y catálogo web (servicio webcatalog).
# Empresa cuya tienda se publica y sucursal cuyo stock ve la web (donde se retiran las reservas):
MINV_STOREFRONT_TENANT=TECHZONE
MINV_STOREFRONT_BRANCH=CM
# Origen exacto del catálogo web permitido por CORS (sin barra final), p. ej. https://tienda.suempresa.com:
MINV_STOREFRONT_ORIGIN=http://localhost:5173
# Horas que vale una reserva (48) y si la tienda está encendida (false: /storefront/v1 responde 503):
MINV_STOREFRONT_HOURS=48
MINV_STOREFRONT_ENABLED=true
# URL del gateway que ve el NAVEGADOR (Vite la incrusta al construir webcatalog; cambiarla exige reconstruir).
# «/» = mismo origen: el nginx del catálogo reenvía /storefront/ al gateway (un solo enlace público para la web y su API).
MINV_WEB_API_URL=/
# El gateway toma la IP del cliente de X-Forwarded-For SOLO desde la red interna de Docker (límite por IP real):
MINV_FORWARDED_HEADERS=true
# Dirección donde se publican los puertos: 127.0.0.1 (solo este equipo; la tienda sale por el túnel) o 0.0.0.0 (detrás
# de un proxy TLS propio en un servidor):
MINV_BIND=127.0.0.1
# V7 · Sesión web y panel del servidor en la nube (/api/v1/web/*): encendida o no, empresa y sucursal de la web
# (las cuentas de cliente se crean en esa empresa y reservan en esa sucursal):
MINV_WEB_ENABLED=true
MINV_WEB_TENANT=TECHZONE
MINV_WEB_BRANCH=CM
# V7 · Correo de confirmación de las reservas: lo envía el gateway DESPUÉS de reservar (cola de correos, 5 intentos).
# Usa el servidor de correo de la empresa (escritorio: Configuración › Facturación › Correo) si está activo; si no, este.
# Gmail: smtp.gmail.com, puerto 587, STARTTLS y una CONTRASEÑA DE APLICACIÓN (solo la genera el dueño de la cuenta, con la
# verificación en dos pasos activa). La contraseña va SOLO en deploy/.env: nunca en el repositorio ni en la documentación.
MINV_MAIL_ENABLED=false
MINV_MAIL_HOST=smtp.gmail.com
MINV_MAIL_PORT=587
MINV_MAIL_STARTTLS=true
MINV_MAIL_USER=<cuenta de Gmail de la empresa>
MINV_MAIL_PASSWORD=<contraseña de aplicación>
MINV_MAIL_FROM=<cuenta de Gmail de la empresa>
MINV_MAIL_FROM_NAME=<nombre comercial>
# Segundos entre pasadas cuando la cola está vacía:
MINV_MAIL_INTERVAL=15
# Dirección pública de la tienda, p. ej. https://tienda.suempresa.com: el correo enlaza «Ver mi reserva» a
# <MINV_PUBLIC_URL>/reserva/<número> (vacío = el correo sale sin el enlace):
MINV_PUBLIC_URL=
# Buzón de PRUEBA (--profile correo-prueba, nunca en producción): MINV_MAIL_ENABLED=true, MINV_MAIL_HOST=buzon,
# MINV_MAIL_PORT=1025, MINV_MAIL_STARTTLS=false y MINV_MAIL_USER / MINV_MAIL_PASSWORD vacíos; los correos se ven en
# http://127.0.0.1:8025 (solo este equipo).
