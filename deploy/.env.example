# M-INV V4/V4.1 · variables de los servidores (copie a deploy/.env; NUNCA versione deploy/.env).
# Cadena del rol minv_server (sin BYPASSRLS, no dueño de las tablas) con TLS verificado:
MINV_DB=Host=<servidor>;Port=25060;Database=minv;Username=minv_server;Password=<clave>;SSL Mode=VerifyFull;Root Certificate=/certs/ca.crt
# Réplica de lectura para el modelo de reportes (opcional; vacío = la misma base):
MINV_DB_READ=
# Claves maestras AES-256 de los secretos de webhooks y del token delegado del SIN: id:base64(32 bytes)[;id2:...]
# (la primera es la vigente; al rotar, deje la anterior después para poder descifrar lo ya guardado)
MINV_INTEGRATION_KEYS=nube1:<base64 de 32 bytes>
# V4.1 · Trabajo automático de la facturación SIAT en el servidor en la nube (envío, recuperación, CUFD del día): true/false
MINV_SIAT_BACKGROUND=true
# V4.1 · Solo para el perfil siat-simulador (ensayos): token de SIMULACIÓN que acepta el simulador del SIN
# (el MINV_SIAT_TOKEN de %LOCALAPPDATA%\M-INV\claves-integracion.txt de la carga de prueba; vacío = cualquiera de prueba).
# El token REAL del SIN nunca va aquí: se carga cifrado en Configuración › Facturación SIAT del escritorio.
MINV_SIAT_TOKEN=
# Solo para el perfil local-db (PostgreSQL de ensayo en un contenedor):
POSTGRES_PASSWORD=<clave de ensayo>
