# Normalización de fin de línea
* text=auto
*.py   text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.ps1  text eol=crlf

# VBA: el Editor de VBA exige CRLF al importar
*.bas  text eol=crlf
*.cls  text eol=crlf
src/macros/*.txt text eol=crlf

# Binarios (sin diff de texto)
*.xlsx binary
*.xlsm binary
*.png  binary
