<Project Sdk="Microsoft.NET.Sdk">
  <!-- Persistencia PostgreSQL (EF Core Code-First + Npgsql), multi-tenant, auditoría, importación desde la V2.1 y modo
       demostración en memoria. -->
  <PropertyGroup>
    <RootNamespace>MINV.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\1. Core\MINV.Application\MINV.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- V4.2 · Datos del rubro Tecnología de la empresa de prueba Tech Zone Gaming S.R.L. (datos de prueba y demostración):
         catálogo con fichas técnicas, productos del SIN de sus actividades e ilustraciones propias
         (tools/tecnologia/generar_catalogo.py y tools/tecnologia/generar_imagenes_tecnologia.py). -->
    <EmbeddedResource Include="Seeding\Tecnologia\catalogo-tecnologia.json" />
    <EmbeddedResource Include="Seeding\Tecnologia\catalogo-productos-sin-tecnologia.csv" />
    <EmbeddedResource Include="Seeding\Tecnologia\Imagenes\*.png" />
    <!-- V4.1 · XSD oficiales del SIN (modalidad computarizada): validación antes de guardar y en el simulador -->
    <EmbeddedResource Include="Billing\Xsd\*.xsd" />
    <!-- V4.1 · Datos de SIMULACIÓN del simulador del SIN (catálogo de productos SIN de ferretería y construcción; V4.2: más
         los de tecnología, embebidos arriba) -->
    <EmbeddedResource Include="Billing\Simulator\Datos\*.csv" />
  </ItemGroup>
  <ItemGroup>
    <!-- V4.1 · Cliente SOAP del SIN (IHttpClientFactory, cliente «siat») y servicio en segundo plano de la facturación -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MINV.Infrastructure.Tests" />
  </ItemGroup>
</Project>
