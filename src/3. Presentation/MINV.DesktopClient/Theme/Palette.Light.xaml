<!--
    Paleta CLARA de M-INV V4.2 · Edición Tecnología y Gaming. Las vistas y los estilos usan siempre {DynamicResource Clave}:
    al cambiar de tema se reemplaza este diccionario por Palette.Dark.xaml (el predeterminado de la edición gaming) y toda
    la interfaz cambia sin reiniciar. Blanco y gris frío con los mismos acentos violeta #7C3AED ↔ cian.
    Los colores de estado son los del semáforo de la V2.1 (AGOTADO, CRÍTICO, BAJO, ÓPTIMO, SOBRESTOCK, INCONSISTENTE).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Superficies -->
    <SolidColorBrush x:Key="Canvas" Color="#F3F4FA" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F8F8FD" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#F0F1F8" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#E3E5F0" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Border" Color="#E2E4EF" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C8CCDD" />
    <SolidColorBrush x:Key="Overlay" Color="#660B0F1A" />
    <Color x:Key="ShadowColor">#0B0F1A</Color>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimary" Color="#0B1020" />
    <SolidColorBrush x:Key="TextSecondary" Color="#2F3650" />
    <SolidColorBrush x:Key="TextMuted" Color="#5B6380" />
    <SolidColorBrush x:Key="TextFaint" Color="#9097AE" />

    <!-- Marca (violeta gaming) -->
    <SolidColorBrush x:Key="Brand" Color="#7C3AED" />
    <SolidColorBrush x:Key="BrandHover" Color="#6D28D9" />
    <SolidColorBrush x:Key="BrandPressed" Color="#5B21B6" />
    <SolidColorBrush x:Key="BrandSoft" Color="#F1EBFE" />
    <SolidColorBrush x:Key="BrandSoftHover" Color="#E6DBFD" />
    <SolidColorBrush x:Key="BrandText" Color="#5B21B6" />
    <SolidColorBrush x:Key="OnBrand" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E1065" Offset="0" />
        <GradientStop Color="#6D28D9" Offset="0.55" />
        <GradientStop Color="#0891B2" Offset="1" />
    </LinearGradientBrush>

    <!-- Barra lateral (siempre oscura) -->
    <SolidColorBrush x:Key="Sidebar" Color="#0B0F1A" />
    <SolidColorBrush x:Key="SidebarBorder" Color="#171E30" />
    <SolidColorBrush x:Key="SidebarText" Color="#C9CFE0" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#7C86A2" />
    <SolidColorBrush x:Key="SidebarHover" Color="#161D30" />
    <SolidColorBrush x:Key="SidebarSelected" Color="#7C3AED" />

    <!-- Semánticos -->
    <SolidColorBrush x:Key="Success" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#DCFCE7" />
    <SolidColorBrush x:Key="Warning" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Danger" Color="#C81E1E" />
    <SolidColorBrush x:Key="DangerHover" Color="#A51B1B" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Info" Color="#0E7490" />
    <SolidColorBrush x:Key="InfoSoft" Color="#E0F7FB" />
    <!-- Poka-yoke de la V2.1: rojo sangre con texto blanco -->
    <SolidColorBrush x:Key="BloodRed" Color="#8A0303" />

    <!-- Semáforo de stock (texto / fondo suave / barra); SOBRESTOCK en el azul informativo de la V2.1 -->
    <SolidColorBrush x:Key="StatusOutOfStock" Color="#C81E1E" />
    <SolidColorBrush x:Key="StatusOutOfStockSoft" Color="#FDE4E4" />
    <SolidColorBrush x:Key="StatusCritical" Color="#C2410C" />
    <SolidColorBrush x:Key="StatusCriticalSoft" Color="#FFEDD5" />
    <SolidColorBrush x:Key="StatusLow" Color="#955A06" />
    <SolidColorBrush x:Key="StatusLowSoft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="StatusOptimal" Color="#15803D" />
    <SolidColorBrush x:Key="StatusOptimalSoft" Color="#DCFCE7" />
    <SolidColorBrush x:Key="StatusOverstock" Color="#1D4ED8" />
    <SolidColorBrush x:Key="StatusOverstockSoft" Color="#DBEAFE" />
    <SolidColorBrush x:Key="StatusInconsistent" Color="#8A0303" />
    <SolidColorBrush x:Key="StatusInconsistentSoft" Color="#FBD5D5" />
    <SolidColorBrush x:Key="StatusInactive" Color="#5B6780" />
    <SolidColorBrush x:Key="StatusInactiveSoft" Color="#EEF2F6" />

    <!-- Gráficos (entradas cian, salidas magenta) -->
    <SolidColorBrush x:Key="ChartEntries" Color="#0891B2" />
    <SolidColorBrush x:Key="ChartIssues" Color="#C026D3" />
    <SolidColorBrush x:Key="ChartGrid" Color="#ECEEF6" />
    <SolidColorBrush x:Key="ChartTrack" Color="#EEF0F7" />

    <!-- V4.2 · Acentos gaming (claves propias del escritorio, en AMBOS temas) -->
    <!-- Degradado horizontal decorativo: líneas de acento, barras de progreso e indicadores (sin texto encima) -->
    <LinearGradientBrush x:Key="BrandGradientStrip" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#0891B2" Offset="1" />
    </LinearGradientBrush>
    <!-- Botón principal y opción activa del menú: violeta → cian oscuro (texto blanco ≥ 5,3:1 en todo el recorrido) -->
    <LinearGradientBrush x:Key="BrandGradientButton" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#0E7490" Offset="1" />
    </LinearGradientBrush>
    <!-- Al pasar el mouse: un tono más profundo (texto blanco ≥ 7:1) -->
    <LinearGradientBrush x:Key="BrandGradientButtonHover" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#6D28D9" Offset="0" />
        <GradientStop Color="#155E75" Offset="1" />
    </LinearGradientBrush>
    <!-- Foco visible del teclado (anillo neón; ≥ 3:1 sobre todas las superficies) -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#0891B2" />
</ResourceDictionary>
