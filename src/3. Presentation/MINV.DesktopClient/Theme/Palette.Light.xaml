<!--
    Paleta CLARA de M-INV. Las vistas y los estilos usan siempre {DynamicResource Clave}: al cambiar de tema se reemplaza
    este diccionario por Palette.Dark.xaml y toda la interfaz cambia sin reiniciar.
    Los colores de estado son los del semáforo de la V2.1 (AGOTADO, CRÍTICO, BAJO, ÓPTIMO, SOBRESTOCK, INCONSISTENTE).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Superficies -->
    <SolidColorBrush x:Key="Canvas" Color="#F3F6FB" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#E2E8F0" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Border" Color="#E3E8EF" />
    <SolidColorBrush x:Key="BorderStrong" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Overlay" Color="#660F172A" />
    <Color x:Key="ShadowColor">#0F172A</Color>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondary" Color="#334155" />
    <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
    <SolidColorBrush x:Key="TextFaint" Color="#94A3B8" />

    <!-- Marca (azul M-INV) -->
    <SolidColorBrush x:Key="Brand" Color="#1565C0" />
    <SolidColorBrush x:Key="BrandHover" Color="#1259AB" />
    <SolidColorBrush x:Key="BrandPressed" Color="#0D4A91" />
    <SolidColorBrush x:Key="BrandSoft" Color="#E8F1FD" />
    <SolidColorBrush x:Key="BrandSoftHover" Color="#D6E6FB" />
    <SolidColorBrush x:Key="BrandText" Color="#1259AB" />
    <SolidColorBrush x:Key="OnBrand" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B3D8C" Offset="0" />
        <GradientStop Color="#1565C0" Offset="0.55" />
        <GradientStop Color="#0EA5E9" Offset="1" />
    </LinearGradientBrush>

    <!-- Barra lateral (siempre oscura) -->
    <SolidColorBrush x:Key="Sidebar" Color="#0B1324" />
    <SolidColorBrush x:Key="SidebarBorder" Color="#16213A" />
    <SolidColorBrush x:Key="SidebarText" Color="#C7D2E3" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#6B7A93" />
    <SolidColorBrush x:Key="SidebarHover" Color="#16213A" />
    <SolidColorBrush x:Key="SidebarSelected" Color="#1565C0" />

    <!-- Semánticos -->
    <SolidColorBrush x:Key="Success" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#DCFCE7" />
    <SolidColorBrush x:Key="Warning" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHover" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Info" Color="#0369A1" />
    <SolidColorBrush x:Key="InfoSoft" Color="#E0F2FE" />
    <!-- Poka-yoke de la V2.1: rojo sangre con texto blanco -->
    <SolidColorBrush x:Key="BloodRed" Color="#8A0303" />

    <!-- Semáforo de stock (texto / fondo suave / barra) -->
    <SolidColorBrush x:Key="StatusOutOfStock" Color="#C81E1E" />
    <SolidColorBrush x:Key="StatusOutOfStockSoft" Color="#FDE4E4" />
    <SolidColorBrush x:Key="StatusCritical" Color="#C2410C" />
    <SolidColorBrush x:Key="StatusCriticalSoft" Color="#FFEDD5" />
    <SolidColorBrush x:Key="StatusLow" Color="#A16207" />
    <SolidColorBrush x:Key="StatusLowSoft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="StatusOptimal" Color="#15803D" />
    <SolidColorBrush x:Key="StatusOptimalSoft" Color="#DCFCE7" />
    <SolidColorBrush x:Key="StatusOverstock" Color="#6D28D9" />
    <SolidColorBrush x:Key="StatusOverstockSoft" Color="#EDE9FE" />
    <SolidColorBrush x:Key="StatusInconsistent" Color="#8A0303" />
    <SolidColorBrush x:Key="StatusInconsistentSoft" Color="#FBD5D5" />
    <SolidColorBrush x:Key="StatusInactive" Color="#64748B" />
    <SolidColorBrush x:Key="StatusInactiveSoft" Color="#EEF2F6" />

    <!-- Gráficos -->
    <SolidColorBrush x:Key="ChartEntries" Color="#1E88E5" />
    <SolidColorBrush x:Key="ChartIssues" Color="#F59E0B" />
    <SolidColorBrush x:Key="ChartGrid" Color="#EDF1F6" />
    <SolidColorBrush x:Key="ChartTrack" Color="#EEF2F7" />
</ResourceDictionary>
