<!-- Paleta OSCURA de M-INV (mismas claves que Palette.Light.xaml). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Superficies -->
    <SolidColorBrush x:Key="Canvas" Color="#0A0F1C" />
    <SolidColorBrush x:Key="Surface" Color="#111827" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#0F1624" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#1A2334" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#243045" />
    <SolidColorBrush x:Key="InputBackground" Color="#0D1422" />
    <SolidColorBrush x:Key="Border" Color="#1F2A3D" />
    <SolidColorBrush x:Key="BorderStrong" Color="#334155" />
    <SolidColorBrush x:Key="Overlay" Color="#B3000000" />
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EDF5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C3CCDA" />
    <SolidColorBrush x:Key="TextMuted" Color="#8C99AE" />
    <SolidColorBrush x:Key="TextFaint" Color="#5E6B80" />

    <!-- Marca -->
    <SolidColorBrush x:Key="Brand" Color="#3B82F6" />
    <SolidColorBrush x:Key="BrandHover" Color="#5A96F8" />
    <SolidColorBrush x:Key="BrandPressed" Color="#2563EB" />
    <SolidColorBrush x:Key="BrandSoft" Color="#15254A" />
    <SolidColorBrush x:Key="BrandSoftHover" Color="#1C3160" />
    <SolidColorBrush x:Key="BrandText" Color="#8AB6FB" />
    <SolidColorBrush x:Key="OnBrand" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A2A63" Offset="0" />
        <GradientStop Color="#1552B0" Offset="0.55" />
        <GradientStop Color="#0B7FB8" Offset="1" />
    </LinearGradientBrush>

    <!-- Barra lateral -->
    <SolidColorBrush x:Key="Sidebar" Color="#070B15" />
    <SolidColorBrush x:Key="SidebarBorder" Color="#131B2C" />
    <SolidColorBrush x:Key="SidebarText" Color="#C7D2E3" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#5F6D85" />
    <SolidColorBrush x:Key="SidebarHover" Color="#121A2B" />
    <SolidColorBrush x:Key="SidebarSelected" Color="#2563EB" />

    <!-- Semánticos -->
    <SolidColorBrush x:Key="Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#12301F" />
    <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningSoft" Color="#33270A" />
    <SolidColorBrush x:Key="Danger" Color="#F87171" />
    <SolidColorBrush x:Key="DangerHover" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerSoft" Color="#3A1414" />
    <SolidColorBrush x:Key="Info" Color="#38BDF8" />
    <SolidColorBrush x:Key="InfoSoft" Color="#0C2A3D" />
    <SolidColorBrush x:Key="BloodRed" Color="#A10A0A" />

    <!-- Semáforo de stock -->
    <SolidColorBrush x:Key="StatusOutOfStock" Color="#F87171" />
    <SolidColorBrush x:Key="StatusOutOfStockSoft" Color="#3B1518" />
    <SolidColorBrush x:Key="StatusCritical" Color="#FB923C" />
    <SolidColorBrush x:Key="StatusCriticalSoft" Color="#3A1F0E" />
    <SolidColorBrush x:Key="StatusLow" Color="#FACC15" />
    <SolidColorBrush x:Key="StatusLowSoft" Color="#342A0A" />
    <SolidColorBrush x:Key="StatusOptimal" Color="#4ADE80" />
    <SolidColorBrush x:Key="StatusOptimalSoft" Color="#11301E" />
    <SolidColorBrush x:Key="StatusOverstock" Color="#A78BFA" />
    <SolidColorBrush x:Key="StatusOverstockSoft" Color="#261A45" />
    <SolidColorBrush x:Key="StatusInconsistent" Color="#FF6B6B" />
    <SolidColorBrush x:Key="StatusInconsistentSoft" Color="#4A0A0A" />
    <SolidColorBrush x:Key="StatusInactive" Color="#94A3B8" />
    <SolidColorBrush x:Key="StatusInactiveSoft" Color="#1E2635" />

    <!-- Gráficos -->
    <SolidColorBrush x:Key="ChartEntries" Color="#60A5FA" />
    <SolidColorBrush x:Key="ChartIssues" Color="#FBBF24" />
    <SolidColorBrush x:Key="ChartGrid" Color="#1B2536" />
    <SolidColorBrush x:Key="ChartTrack" Color="#1C2638" />
</ResourceDictionary>
