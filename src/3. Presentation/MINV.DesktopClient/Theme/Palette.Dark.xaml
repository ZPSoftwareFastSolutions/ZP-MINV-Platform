<!--
    Paleta OSCURA de M-INV V4.2 · Edición Tecnología y Gaming (tema predeterminado). Mismas claves que Palette.Light.xaml.
    Casi negro azulado en capas, bordes sutiles, marca violeta #7C3AED con degradado violeta → cian y estados de neón
    legibles (contraste WCAG AA del texto sobre su superficie y sobre su fondo suave).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Superficies (capas: lienzo → superficie alterna → tarjeta → hover → presionado) -->
    <SolidColorBrush x:Key="Canvas" Color="#0A0E17" />
    <SolidColorBrush x:Key="Surface" Color="#141B2B" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#0F1522" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#1B2338" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#242E47" />
    <SolidColorBrush x:Key="InputBackground" Color="#0C111C" />
    <SolidColorBrush x:Key="Border" Color="#1F2840" />
    <SolidColorBrush x:Key="BorderStrong" Color="#35415F" />
    <SolidColorBrush x:Key="Overlay" Color="#B305070D" />
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimary" Color="#EEF1FA" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C4CADB" />
    <SolidColorBrush x:Key="TextMuted" Color="#8E97B2" />
    <SolidColorBrush x:Key="TextFaint" Color="#5E6784" />

    <!-- Marca (violeta gaming; el cian vive en el degradado y en Info) -->
    <SolidColorBrush x:Key="Brand" Color="#7C3AED" />
    <SolidColorBrush x:Key="BrandHover" Color="#8445F0" />
    <SolidColorBrush x:Key="BrandPressed" Color="#6D28D9" />
    <SolidColorBrush x:Key="BrandSoft" Color="#1C1440" />
    <SolidColorBrush x:Key="BrandSoftHover" Color="#281C57" />
    <SolidColorBrush x:Key="BrandText" Color="#C4B5FD" />
    <SolidColorBrush x:Key="OnBrand" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E1065" Offset="0" />
        <GradientStop Color="#6D28D9" Offset="0.55" />
        <GradientStop Color="#0891B2" Offset="1" />
    </LinearGradientBrush>

    <!-- Barra lateral -->
    <SolidColorBrush x:Key="Sidebar" Color="#070A12" />
    <SolidColorBrush x:Key="SidebarBorder" Color="#161C2D" />
    <SolidColorBrush x:Key="SidebarText" Color="#C9CFE0" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#7C86A2" />
    <SolidColorBrush x:Key="SidebarHover" Color="#141A2B" />
    <SolidColorBrush x:Key="SidebarSelected" Color="#7C3AED" />

    <!-- Semánticos (neón) -->
    <SolidColorBrush x:Key="Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#0D2A1A" />
    <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningSoft" Color="#2D2208" />
    <SolidColorBrush x:Key="Danger" Color="#FB7185" />
    <SolidColorBrush x:Key="DangerHover" Color="#F43F5E" />
    <SolidColorBrush x:Key="DangerSoft" Color="#3A1220" />
    <SolidColorBrush x:Key="Info" Color="#22D3EE" />
    <SolidColorBrush x:Key="InfoSoft" Color="#0A2833" />
    <!-- Poka-yoke de la V2.1: rojo sangre con texto blanco -->
    <SolidColorBrush x:Key="BloodRed" Color="#A10A0A" />

    <!-- Semáforo de stock (texto / fondo suave / barra); SOBRESTOCK vuelve al azul informativo de la V2.1 -->
    <SolidColorBrush x:Key="StatusOutOfStock" Color="#FB7185" />
    <SolidColorBrush x:Key="StatusOutOfStockSoft" Color="#3B1420" />
    <SolidColorBrush x:Key="StatusCritical" Color="#FB923C" />
    <SolidColorBrush x:Key="StatusCriticalSoft" Color="#3A200D" />
    <SolidColorBrush x:Key="StatusLow" Color="#FACC15" />
    <SolidColorBrush x:Key="StatusLowSoft" Color="#332A08" />
    <SolidColorBrush x:Key="StatusOptimal" Color="#4ADE80" />
    <SolidColorBrush x:Key="StatusOptimalSoft" Color="#0E2C1B" />
    <SolidColorBrush x:Key="StatusOverstock" Color="#60A5FA" />
    <SolidColorBrush x:Key="StatusOverstockSoft" Color="#10244A" />
    <SolidColorBrush x:Key="StatusInconsistent" Color="#FF6B6B" />
    <SolidColorBrush x:Key="StatusInconsistentSoft" Color="#4A0A0A" />
    <SolidColorBrush x:Key="StatusInactive" Color="#94A3B8" />
    <SolidColorBrush x:Key="StatusInactiveSoft" Color="#1C2333" />

    <!-- Gráficos (entradas cian, salidas magenta) -->
    <SolidColorBrush x:Key="ChartEntries" Color="#22D3EE" />
    <SolidColorBrush x:Key="ChartIssues" Color="#E879F9" />
    <SolidColorBrush x:Key="ChartGrid" Color="#1A2236" />
    <SolidColorBrush x:Key="ChartTrack" Color="#1C253B" />

    <!-- V4.2 · Acentos gaming (claves propias del escritorio, en AMBOS temas) -->
    <!-- Degradado horizontal decorativo: líneas de acento, barras de progreso e indicadores (sin texto encima) -->
    <LinearGradientBrush x:Key="BrandGradientStrip" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <!-- Botón principal y opción activa del menú: violeta → cian oscuro (texto blanco ≥ 5,3:1 en todo el recorrido) -->
    <LinearGradientBrush x:Key="BrandGradientButton" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#0E7490" Offset="1" />
    </LinearGradientBrush>
    <!-- Al pasar el mouse: violeta más luminoso (texto blanco ≥ 5,1:1) -->
    <LinearGradientBrush x:Key="BrandGradientButtonHover" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#8445F0" Offset="0" />
        <GradientStop Color="#0E7490" Offset="1" />
    </LinearGradientBrush>
    <!-- Foco visible del teclado (anillo neón; ≥ 3:1 sobre todas las superficies) -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#22D3EE" />
</ResourceDictionary>
