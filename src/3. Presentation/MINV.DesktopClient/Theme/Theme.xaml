<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta de M-INV (la misma de la V1.2 y la V2.1) -->
    <Color x:Key="InkColor">#0F172A</Color>
    <Color x:Key="Ink2Color">#1E293B</Color>
    <Color x:Key="BrandColor">#1565C0</Color>
    <Color x:Key="CanvasColor">#F1F5F9</Color>
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Ink2" Color="{StaticResource Ink2Color}" />
    <SolidColorBrush x:Key="Brand" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="Canvas" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="Muted" Color="#64748B" />
    <SolidColorBrush x:Key="Ok" Color="#2E7D32" />
    <SolidColorBrush x:Key="Danger" Color="#C62828" />
    <SolidColorBrush x:Key="BloodRed" Color="#8A0303" />
    <SolidColorBrush x:Key="Border" Color="#CBD5E1" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource Canvas}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brand}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#CBD5E1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    </Style>

    <!-- Tablas virtualizadas: solo se dibujan las filas visibles (fluidez con 100.000+ productos) -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
        <Setter Property="RowHeight" Value="26" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Ink2}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
</ResourceDictionary>
