<!-- V7 · Plantillas de las reservas: cuerpo del formulario «Nueva reserva en mostrador». El marco (título, error y botones) lo
     dibuja MainWindow. Colores solo de la paleta (A-09, T-08). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
                    xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">

    <DataTemplate DataType="{x:Type vm:CounterReservationDialog}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cliente, contacto, plazo y datos para la factura -->
            <StackPanel>
                <TextBlock Text="CLIENTE" Style="{StaticResource Overline}" Margin="0,4,0,8" />
                <TextBlock Text="Cliente registrado (opcional)" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" IsTextSearchEnabled="True"
                          AutomationProperties.Name="Cliente registrado" />
                <TextBlock Text="Nombre de quien recoge" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" c:Ui.Icon="{x:Static c:Glyphs.Person}"
                         c:Ui.Placeholder="Nombre y apellido" AutomationProperties.Name="Nombre de quien recoge" />
                <TextBlock Text="Teléfono o WhatsApp" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" c:Ui.Icon="{x:Static c:Glyphs.Phone}"
                         c:Ui.Placeholder="7 u 8 dígitos, con o sin +591" AutomationProperties.Name="Teléfono" />
                <TextBlock Text="Correo (opcional: recibe la confirmación)" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" c:Ui.Icon="{x:Static c:Glyphs.Mail}"
                         c:Ui.Placeholder="nombre@correo.com" AutomationProperties.Name="Correo" />
                <TextBlock Text="Días para recogerla" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                <ComboBox ItemsSource="{Binding HoldOptions}" SelectedItem="{Binding HoldDays}" AutomationProperties.Name="Días para recogerla" />
                <TextBlock Text="Notas (opcional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" c:Ui.Placeholder="Por ejemplo: pasa el sábado por la mañana"
                         AutomationProperties.Name="Notas" />

                <TextBlock Text="DATOS PARA LA FACTURA (OPCIONAL)" Style="{StaticResource Overline}" Margin="0,16,0,8" />
                <ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding DocumentType}" AutomationProperties.Name="Tipo de documento" />
                <Grid Margin="0,8,0,0" Visibility="{Binding HasDocument, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" c:Ui.Placeholder="Número de documento"
                             AutomationProperties.Name="Número de documento" />
                    <TextBox Grid.Column="1" Width="90" Margin="8,0,0,0" Text="{Binding Complement, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                             c:Ui.Placeholder="Compl." ToolTip="Complemento del SEGIP (solo con CI)" AutomationProperties.Name="Complemento"
                             Visibility="{Binding IsCi, Converter={StaticResource Visible}}" />
                </Grid>
                <TextBox Margin="0,8,0,0" Text="{Binding BuyerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" c:Ui.Placeholder="Nombre o razón social"
                         AutomationProperties.Name="Nombre o razón social" Visibility="{Binding HasDocument, Converter={StaticResource Visible}}" />
                <TextBlock Text="La caja los precarga al cobrar la reserva." Style="{StaticResource Caption}" FontSize="11.5" Margin="0,6,0,0"
                           Visibility="{Binding HasDocument, Converter={StaticResource Visible}}" />
            </StackPanel>

            <!-- Productos: buscador y carrito -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="PRODUCTOS" Style="{StaticResource Overline}" Margin="0,4,0,8" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}"
                             c:Ui.Placeholder="Buscar por nombre, SKU o código de barras" AutomationProperties.Name="Buscar un producto" />
                    <Border Style="{StaticResource Panel}" Padding="4" Margin="0,6,0,0" Visibility="{Binding Suggestions.Count, Converter={StaticResource HasValue}}">
                        <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CounterProductOption}">
                                    <Button Style="{StaticResource RowButton}" Padding="8,6" ToolTip="Agregar a la reserva"
                                            Command="{Binding DataContext.AddProduct, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Add}" FontSize="12"
                                                       Foreground="{DynamicResource BrandText}" Margin="8,0,0,0" />
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding AvailableText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Sku, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="Ningún producto coincide: pruebe con parte del nombre o el SKU." Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Visibility="{Binding NoSuggestions, Converter={StaticResource Visible}}" />
                </StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontWeight="SemiBold" FontSize="18" FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}">
                        <Run Text="Total a precio de hoy · " /><Run Text="{Binding LinesText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <Grid Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CounterCartLine}">
                                <Border Style="{StaticResource Panel}" Padding="10,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="9" Content="{x:Static c:Glyphs.Close}"
                                                ToolTip="Quitar" Foreground="{DynamicResource Danger}" VerticalAlignment="Top"
                                                Command="{Binding DataContext.RemoveLine, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Button Width="24" Height="24" Padding="0" FontFamily="{StaticResource IconFont}" FontSize="8" Content="{x:Static c:Glyphs.Remove}"
                                                    Command="{Binding Decrease}" ToolTip="Una menos" />
                                            <TextBlock Text="{Binding QuantityText}" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Button Width="24" Height="24" Padding="0" FontFamily="{StaticResource IconFont}" FontSize="8" Content="{x:Static c:Glyphs.Add}"
                                                    Command="{Binding Increase}" ToolTip="Una más" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="11">
                                                <Run Text="{Binding Sku, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UnitPriceText, Mode=OneWay}" />
                                                <Run Text=" · " /><Run Text="{Binding SubtotalText, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding AvailableText}" FontSize="11" Foreground="{DynamicResource Danger}"
                                                       Visibility="{Binding ExceedsAvailable, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Cart}" Visibility="{Binding HasLines, Converter={StaticResource Hidden}}">
                        <TextBlock Text="Busque y agregue los productos que el cliente se lleva" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="240" />
                    </ContentControl>
                </Grid>
            </DockPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
