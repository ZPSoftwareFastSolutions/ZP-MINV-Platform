<Window x:Class="MINV.DesktopClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
        xmlns:v="clr-namespace:MINV.DesktopClient.Views"
        xmlns:p="clr-namespace:MINV.DesktopClient.Views.Pages"
        xmlns:s="clr-namespace:MINV.DesktopClient.Services"
        xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels"
        xmlns:app="clr-namespace:MINV.DesktopClient"
        Title="M-INV" Width="1440" Height="900" MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}" Icon="/Assets/minv.ico" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <v:BoolToVisibilityConverter x:Key="Visible" />
        <v:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
        <v:HasValueToVisibilityConverter x:Key="HasValue" />
        <v:AvatarBrushConverter x:Key="AvatarBrush" />
        <v:SidebarWidthConverter x:Key="SidebarWidth" />

        <!-- Pantallas -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><p:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockViewModel}"><p:StockView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovementViewModel}"><p:MovementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhysicalCountViewModel}"><p:PhysicalCountView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}"><p:AlertsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderViewModel}"><p:OrderView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><p:ActivityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><p:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}"><p:HelpView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductDetailViewModel}"><p:ProductDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogViewModel}"><p:CatalogView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}"><p:PosView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}"><p:SalesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><p:CustomersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseOrdersViewModel}"><p:PurchaseOrdersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}"><p:SuppliersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><p:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountingViewModel}"><p:AccountingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><p:UsersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BranchesViewModel}"><p:BranchesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransfersViewModel}"><p:TransfersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:IntegrationsViewModel}"><p:IntegrationsView /></DataTemplate>

        <!-- Botón del menú lateral -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="42" CornerRadius="10" Background="Transparent" Padding="13,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHover}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelected}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="NavItem" DataType="{x:Type vm:PageViewModel}">
            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                         ToolTipService.Placement="Right"
                         ToolTipService.IsEnabled="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}">
                <RadioButton.ToolTip>
                    <TextBlock>
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Shortcut, Mode=OneWay}" Foreground="#94A3B8" />
                    </TextBlock>
                </RadioButton.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Left"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" FontSize="13.5" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                               Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hidden}}" />
                    <Border Grid.Column="2" Background="#E11D48" CornerRadius="9" MinWidth="20" Height="18" Padding="6,0"
                            Visibility="{Binding Badge, Converter={StaticResource HasValue}}">
                        <TextBlock Text="{Binding Badge}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsCompact, Converter={StaticResource SidebarWidth}}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================================ menú lateral -->
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="68" Margin="20,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/minv-256.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsCompact, Converter={StaticResource Hidden}}">
                            <TextBlock Text="M-INV" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Inventario inteligente" Foreground="{DynamicResource SidebarMuted}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <ItemsControl ItemsSource="{Binding Footer}" ItemTemplate="{StaticResource NavItem}" Focusable="False" />
                    <Border Height="1" Background="{DynamicResource SidebarBorder}" Margin="4,10" />
                    <Button x:Name="UserButton" Command="{Binding ToggleUserMenu}" Height="Auto" Padding="8" Background="Transparent"
                            BorderBrush="Transparent" Tag="{DynamicResource SidebarHover}" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                            ToolTip="Su cuenta">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{Binding UserName, Converter={StaticResource AvatarBrush}}">
                                <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.ChevronRight}" FontSize="10"
                                       Foreground="{DynamicResource SidebarMuted}" Visibility="{Binding IsCompact, Converter={StaticResource Hidden}}" />
                            <StackPanel Margin="10,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsCompact, Converter={StaticResource Hidden}}">
                                <TextBlock Text="{Binding UserName}" Foreground="#FFFFFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding RoleNames}" Foreground="{DynamicResource SidebarMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="12,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavSection}">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource SidebarMuted}" FontSize="11" FontWeight="SemiBold"
                                               Margin="13,12,0,6"
                                               Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hidden}}" />
                                    <Border Height="1" Background="{DynamicResource SidebarBorder}" Margin="8,12,8,8"
                                            Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                                    <ItemsControl ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource NavItem}" Focusable="False" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================================================================ contenido -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra superior (se puede arrastrar para mover la ventana) -->
            <DockPanel Margin="16,0,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource ChromeButton}" Content="{x:Static c:Glyphs.Remove}" ToolTip="Minimizar" Click="OnMinimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" ToolTip="Maximizar" Click="OnMaximize" />
                    <Button Style="{StaticResource ChromeCloseButton}" Content="{x:Static c:Glyphs.Close}" ToolTip="Cerrar" Click="OnClose" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <!-- V4 · Sucursal activa (la gerencia global puede ver todas) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                                Visibility="{Binding ShowBranchSelector, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Branch}" FontSize="14" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding BranchOptions}" SelectedItem="{Binding SelectedBranch, Mode=TwoWay}" DisplayMemberPath="Label"
                                  MinWidth="200" IsEnabled="{Binding IsChangingBranch, Converter={StaticResource Not}}"
                                  ToolTip="Sucursal en la que trabaja: caja, movimientos y compras se registran en ella" AutomationProperties.Name="Sucursal" />
                    </StackPanel>
                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowBranchSelector, Converter={StaticResource Hidden}}" ToolTip="Sucursal en la que trabaja">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Branch}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding BranchText}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource InfoSoft}" CornerRadius="12" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center"
                            Visibility="{Binding IsCloud, Converter={StaticResource Visible}}"
                            ToolTip="{Binding ConnectionText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Cloud}" FontSize="12" Foreground="{DynamicResource Info}" />
                            <TextBlock Text="NUBE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Info}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource WarningSoft}" CornerRadius="12" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center"
                            Visibility="{Binding IsDemo, Converter={StaticResource Visible}}"
                            ToolTip="Modo demostración: los datos viven en la memoria de este equipo y se pierden al cerrar.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Sparkle}" FontSize="12" Foreground="{DynamicResource Warning}" />
                            <TextBlock Text="DEMOSTRACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Warning}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ClockText}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ToggleTheme}"
                            ToolTip="Cambiar tema claro / oscuro (Ctrl+Shift+L)">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="{x:Static c:Glyphs.Moon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Text" Value="{x:Static c:Glyphs.Sun}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Grid WindowChrome.IsHitTestVisibleInChrome="True" Margin="4,0,0,0">
                        <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Warning}" ToolTip="Alertas de stock"
                                Command="{Binding NavigateCommand}" CommandParameter="{Binding Alerts}" />
                        <Border Background="#E11D48" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,1,-2,0" IsHitTestVisible="False"
                                Visibility="{Binding Alerts.Badge, Converter={StaticResource HasValue}}">
                            <TextBlock Text="{Binding Alerts.Badge}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Menu}" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ToggleSidebar}" ToolTip="Ocultar / mostrar el menú (Ctrl+B)" />
                <v:ProductSearchBox x:Name="GlobalSearch" DataContext="{Binding Search}" Width="460" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"
                                    Placeholder="Buscar un producto…   (Ctrl+K)" />
            </DockPanel>

            <!-- Pantalla actual -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding Current}" Focusable="False" />

                <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Margin="0" Background="Transparent">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Current.IsBusy}" Value="True" />
                                        <Condition Binding="{Binding Current.HasLoaded}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- Primera carga -->
                <Border Background="{DynamicResource Canvas}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Current.IsBusy}" Value="True" />
                                        <Condition Binding="{Binding Current.HasLoaded}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <c:ProgressRing Width="42" Height="42" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" Style="{StaticResource Caption}" FontSize="13">
                            <Run Text="Cargando" /> <Run Text="{Binding Current.Title, Mode=OneWay}" /><Run Text="…" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Error en la primera carga -->
                <Border Background="{DynamicResource Canvas}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Current.HasError}" Value="True" />
                                        <Condition Binding="{Binding Current.HasLoaded}" Value="False" />
                                        <Condition Binding="{Binding Current.IsBusy}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Style="{StaticResource Card}" Width="460" VerticalAlignment="Center" Padding="28">
                        <StackPanel>
                            <Border Style="{StaticResource IconBubble}" Background="{DynamicResource DangerSoft}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Error}" Foreground="{DynamicResource Danger}" FontSize="18" />
                            </Border>
                            <TextBlock Text="No se pudo cargar la pantalla" Style="{StaticResource H2}" Margin="0,14,0,6" />
                            <TextBlock Text="{Binding Current.ErrorMessage}" Style="{StaticResource Body}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Reintentar" HorizontalAlignment="Left" Margin="0,18,0,0"
                                    Command="{Binding Current.Refresh}" c:Ui.Icon="{x:Static c:Glyphs.Refresh}" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================================ ficha del producto -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding IsProductOpen, Converter={StaticResource Visible}}">
            <Border Background="{DynamicResource Overlay}" MouseLeftButtonDown="OnCloseProduct" />
            <Border x:Name="Drawer" HorizontalAlignment="Right" Width="580" Background="{DynamicResource Surface}" Effect="{StaticResource PopupShadow}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerShift" />
                </Border.RenderTransform>
                <ContentControl Content="{Binding ProductDetail}" Focusable="False" />
            </Border>
        </Grid>

        <!-- ============================================================================ confirmación -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding Dialogs.Current, Converter={StaticResource HasValue}}">
            <Border Background="{DynamicResource Overlay}" />
            <Border Style="{StaticResource Card}" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,26"
                    DataContext="{Binding Dialogs.Current}" Effect="{StaticResource PopupShadow}">
                <StackPanel>
                    <Border HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IconBubble}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,16,0,8" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" />
                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Visibility="{Binding HasDetails, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brand}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasInput, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding InputLabel}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="DialogInput" IsEditable="True" ItemsSource="{Binding InputOptions}" MinHeight="42"
                                  Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="{Binding InputPlaceholder}" />
                    </StackPanel>
                    <Border Background="{DynamicResource BrandSoft}" CornerRadius="10" Padding="16,12" Margin="0,16,0,0"
                            Visibility="{Binding HasHighlight, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Copiar" c:Ui.Icon="{x:Static c:Glyphs.Copy}"
                                    Command="{Binding DataContext.CopyText, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Highlight}" />
                            <TextBlock Text="{Binding Highlight}" Style="{StaticResource Mono}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="{Binding CancelText}" Command="{Binding Cancel}" IsCancel="True" MinWidth="110" />
                        <Button Content="{Binding ConfirmText}" Command="{Binding Confirm}" Margin="10,0,0,0" MinWidth="130" IsDefault="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Danger}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                                            <Setter Property="Tag" Value="{DynamicResource DangerHover}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================================ menú de la cuenta -->
        <Popup IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=UserButton}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="-6">
            <Border Width="300" Margin="6,6,12,12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="12" Effect="{StaticResource PopupShadow}">
                <StackPanel>
                    <StackPanel Margin="18,18,18,12">
                        <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left"
                                Background="{Binding UserName, Converter={StaticResource AvatarBrush}}">
                            <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding UserName}" Style="{StaticResource H3}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding UserEmail}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding RoleNames}" Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CompanyName}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource Border}" />
                    <StackPanel Margin="8">
                        <Button Style="{StaticResource GhostButton}" Content="Cambiar contraseña" HorizontalContentAlignment="Left"
                                c:Ui.Icon="{x:Static c:Glyphs.Key}" Command="{Binding ChangePassword}" />
                        <Button Style="{StaticResource GhostButton}" Content="Configuración" HorizontalContentAlignment="Left"
                                c:Ui.Icon="{x:Static c:Glyphs.Settings}" Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding Footer[0]}" />
                        <Button Style="{StaticResource GhostButton}" Content="Cerrar sesión" HorizontalContentAlignment="Left"
                                c:Ui.Icon="{x:Static c:Glyphs.SignOut}" Command="{Binding Logout}" Foreground="{DynamicResource Danger}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============================================================================ avisos -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Notifications.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,24,20" Width="390" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type s:Toast}">
                    <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="12" Margin="0,10,0,0" Effect="{StaticResource PopupShadow}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="40" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0"
                                                         Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Accent" CornerRadius="12,0,0,12" Background="{DynamicResource Success}" />
                            <TextBlock x:Name="Glyph" Grid.Column="1" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" VerticalAlignment="Top"
                                       Margin="14,15,0,0" Foreground="{DynamicResource Success}" />
                            <StackPanel Grid.Column="2" Margin="12,13,4,13">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding Message, Converter={StaticResource HasValue}}" />
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10" VerticalAlignment="Top"
                                    Margin="0,8,8,0" Content="{x:Static c:Glyphs.Close}"
                                    Command="{Binding DataContext.Notifications.Dismiss, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Info">
                            <Setter TargetName="Accent" Property="Background" Value="{DynamicResource Info}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Info}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                            <Setter TargetName="Accent" Property="Background" Value="{DynamicResource Warning}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Warning}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                            <Setter TargetName="Accent" Property="Background" Value="{DynamicResource Danger}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Danger}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
