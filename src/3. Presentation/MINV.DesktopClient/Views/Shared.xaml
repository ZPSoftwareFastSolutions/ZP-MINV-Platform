<!-- Convertidores y plantillas compartidas por todas las pantallas. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
                    xmlns:v="clr-namespace:MINV.DesktopClient.Views"
                    xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <v:BoolToVisibilityConverter x:Key="Visible" />
    <v:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
    <v:HasValueToVisibilityConverter x:Key="HasValue" />
    <v:HasValueToVisibilityConverter x:Key="NoValue" Invert="True" />
    <v:HasValueToBoolConverter x:Key="HasValueBool" />
    <v:NotConverter x:Key="Not" />
    <v:StepNumberConverter x:Key="StepNumber" />
    <v:AvatarBrushConverter x:Key="AvatarBrush" />
    <v:ShareWidthConverter x:Key="ShareWidth" />
    <v:IndentConverter x:Key="Indent" />
    <v:DetailVisibilityConverter x:Key="DetailVisibility" />

    <!-- Chip de filtro con punto de color y contador -->
    <DataTemplate x:Key="FilterChipTemplate" DataType="{x:Type vm:FilterChip}">
        <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                     Command="{Binding DataContext.SelectFilter, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" c:Ui.BrushKey="{Binding BrushKey}"
                         Visibility="{Binding HasColor, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0" MinWidth="22">
                    <TextBlock Text="{Binding Count}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                </Border>
            </StackPanel>
        </RadioButton>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
        <WrapPanel />
    </ItemsPanelTemplate>

    <!-- Movimiento (tablero, registro y sesión) -->
    <DataTemplate x:Key="MovementRow" DataType="{x:Type vm:MovementItem}">
        <DockPanel Margin="0,6">
            <Border x:Name="Bubble" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SuccessSoft}">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource Success}" />
            </Border>
            <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" HorizontalAlignment="Right">
                <TextBlock x:Name="Qty" Text="{Binding QuantityText}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource Success}" />
                <TextBlock Text="{Binding WhenText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" FontSize="11.5" />
            </StackPanel>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding TypeName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsIn}" Value="False">
                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource WarningSoft}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Warning}" />
                <Setter TargetName="Qty" Property="Foreground" Value="{DynamicResource Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Registro de actividad -->
    <DataTemplate x:Key="ActivityRow" DataType="{x:Type vm:ActivityItem}">
        <DockPanel Margin="0,7">
            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top"
                    Background="{Binding UserName, Converter={StaticResource AvatarBrush}}">
                <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" HorizontalAlignment="Right" ToolTip="{Binding ExactTime}">
                <Border x:Name="Pill" CornerRadius="9" Padding="8,2" HorizontalAlignment="Right" Background="{DynamicResource SuccessSoft}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PillGlyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="11" Foreground="{DynamicResource Success}" />
                        <TextBlock x:Name="PillText" Text="{Binding OutcomeText}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0"
                                   Foreground="{DynamicResource Success}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding WhenText}" Style="{StaticResource Caption}" FontSize="11.5" HorizontalAlignment="Right" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="12,0,0,0">
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    <Run Text="{Binding ActionText, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" />
                </TextBlock>
                <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0" Visibility="{Binding HasDetails, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Outcome}" Value="Rejected">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource WarningSoft}" />
                <Setter TargetName="PillGlyph" Property="Foreground" Value="{DynamicResource Warning}" />
                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource DangerSoft}" />
                <Setter TargetName="PillGlyph" Property="Foreground" Value="{DynamicResource Danger}" />
                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Danger}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Estado vacío genérico: Tag = ícono, Content = título, ToolTip no se usa -->
    <Style x:Key="EmptyState" TargetType="ContentControl">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Margin="24">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SurfaceHover}" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="26" Foreground="{DynamicResource TextFaint}" />
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" Margin="0,14,0,0" TextElement.Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indicador (KPI) de los encabezados de las pantallas nuevas: ícono en burbuja de color, valor y detalle -->
    <DataTemplate x:Key="KpiTemplate" DataType="{x:Type vm:KpiCard}">
        <Border Style="{StaticResource CardFlat}" Margin="6" Padding="16,13">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" c:Ui.BrushKey="{Binding SoftKey}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="17" c:Ui.BrushKey="{Binding BrushKey}" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Detail, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="KpiPanel">
        <UniformGrid Rows="1" />
    </ItemsPanelTemplate>

    <!-- Etiqueta de estado con color de la paleta (Tag = clave suave, Foreground por c:Ui.BrushKey del texto) -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Encabezado de un panel lateral de edición -->
    <Style x:Key="EditorPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        <Setter Property="Margin" Value="16,0,0,0" />
    </Style>

    <!-- Mensaje de error de un formulario -->
    <Style x:Key="FormError" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <!-- Fila de ranking con barra proporcional (reportes) -->
    <DataTemplate x:Key="RankRowTemplate" DataType="{x:Type vm:RankRow}">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                <Grid Height="6" Margin="0,5,0,0">
                    <Border Background="{DynamicResource ChartTrack}" CornerRadius="3" />
                    <Border Background="{DynamicResource Brand}" CornerRadius="3" HorizontalAlignment="Left"
                            Width="{Binding Share, Converter={StaticResource ShareWidth}, ConverterParameter=320}" />
                </Grid>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding QuantityText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Grid.Column="3" Text="{Binding AmountText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="{Binding ProfitText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Success}" />
            <TextBlock Grid.Column="5" Text="{Binding ShareText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" />
        </Grid>
    </DataTemplate>

    <!-- Leyenda de un gráfico de dona -->
    <DataTemplate x:Key="LegendRowTemplate" DataType="{x:Type vm:LegendRow}">
        <DockPanel Margin="0,4">
            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" c:Ui.BrushKey="{Binding BrushKey}" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Style="{StaticResource Caption}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Label}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
