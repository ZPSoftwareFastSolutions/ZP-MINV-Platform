<Window x:Class="MINV.DesktopClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M-INV · Iniciar sesión" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel>
        <Border Background="{StaticResource Ink}" Padding="24,20">
            <StackPanel>
                <TextBlock Text="M-INV" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Inventario y punto de venta · V3" Foreground="#94A3B8" />
            </StackPanel>
        </Border>
        <StackPanel Margin="24,20,24,24">
            <TextBlock Text="Empresa" Foreground="{StaticResource Muted}" />
            <TextBox Text="{Binding TenantCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" CharacterCasing="Upper" />
            <TextBlock Text="Correo" Foreground="{StaticResource Muted}" />
            <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="Contraseña" Foreground="{StaticResource Muted}" />
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,16" Padding="6,4" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Button Content="Ingresar" Style="{StaticResource PrimaryButton}" Click="OnLogin" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
