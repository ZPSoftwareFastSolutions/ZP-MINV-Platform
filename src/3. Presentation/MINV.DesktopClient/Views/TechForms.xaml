<!-- V4.2 · Plantillas de la edición Tecnología: cuerpo de los formularios modales (series e IMEI, especificaciones por
     categoría, casos RMA, cotizaciones del armador). El marco del formulario (título, error y botones) lo dibuja MainWindow. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
                    xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">

    <!-- ============================================================================ una línea de series (implícita) -->
    <DataTemplate DataType="{x:Type vm:SerialCaptureLine}">
        <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}" c:Ui.BrushKey="{Binding CountSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding CountText}" FontWeight="Bold" FontSize="12.5" c:Ui.BrushKey="{Binding CountBrush}" />
                    </Border>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource Pill}" Padding="6,0">
                                <TextBlock Text="{Binding Sku}" Style="{StaticResource Mono}" FontSize="11.5" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0">
                                <TextBlock Text="{Binding KindBadge}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Escáner / teclado: Enter agrega (entrada) o marca (salida) -->
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Agregar" c:Ui.Icon="{x:Static c:Glyphs.Add}" Command="{Binding AddInput}" Margin="8,0,0,0"
                            Visibility="{Binding IsEntry, Converter={StaticResource Visible}}" />
                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Barcode}"
                             c:Ui.Placeholder="{Binding Placeholder}" AutomationProperties.Name="Serie o IMEI" MaxLength="80">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddInput}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <Border CornerRadius="8" Padding="10,5" Margin="0,8,0,0" Visibility="{Binding Message, Converter={StaticResource HasValue}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <!-- Entrada: series escritas, escaneadas o pegadas -->
                <StackPanel Visibility="{Binding IsEntry, Converter={StaticResource Visible}}">
                    <ItemsControl ItemsSource="{Binding Entries}" Focusable="False" Margin="0,10,0,0" ItemsPanel="{StaticResource WrapPanelTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SerialEntry}">
                                <Border x:Name="Chip" CornerRadius="8" Padding="9,3,3,3" Margin="0,0,6,6" BorderThickness="1"
                                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" ToolTip="{Binding Problem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Value" Text="{Binding Value}" Style="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="9" Margin="6,0,0,0"
                                                Content="{x:Static c:Glyphs.Close}" ToolTip="Quitar"
                                                Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource DangerSoft}" />
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Danger}" />
                                        <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox x:Name="PasteToggle" Content="Pegar una lista (una serie por renglón o separadas por comas)" Margin="0,4,0,0" />
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsChecked, ElementName=PasteToggle, Converter={StaticResource Visible}}">
                        <TextBox Style="{StaticResource MultilineTextBox}" MinHeight="70" MaxHeight="140" Text="{Binding Paste, UpdateSourceTrigger=PropertyChanged}"
                                 c:Ui.Placeholder="Pegue aquí las series copiadas de la guía del proveedor o de una planilla" />
                        <Button Content="Agregar la lista" c:Ui.Icon="{x:Static c:Glyphs.Add}" Command="{Binding AddPasted}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Salida: disponibles de la sucursal -->
                <StackPanel Visibility="{Binding IsPick, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}"
                             c:Ui.Placeholder="Filtrar las disponibles" Height="34" />
                    <ListBox ItemsSource="{Binding Options}" MaxHeight="220" Margin="0,8,0,0" Style="{StaticResource PlainList}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SerialPickOption}">
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Serial}" Style="{StaticResource Mono}" FontSize="12.5" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No hay unidades disponibles de este producto en la sucursal." Foreground="{DynamicResource Danger}" Margin="0,8,0,0"
                               Visibility="{Binding NoneAvailable, Converter={StaticResource Visible}}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Style="{StaticResource LinkButton}" Content="Empezar de nuevo" Command="{Binding ClearAll}" HorizontalAlignment="Right" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================================ series e IMEI -->
    <DataTemplate DataType="{x:Type vm:SerialsDialog}">
        <StackPanel>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="11.5"
                       Text="Los colores son una guía: al guardar, el sistema vuelve a validar cada serie (única en la empresa, en el estado y la sucursal correctos)." />
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================================ especificaciones por categoría -->
    <DataTemplate DataType="{x:Type vm:SpecsAdminDialog}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="Subcategoría" c:Ui.Icon="{x:Static c:Glyphs.Add}" Command="{Binding NewSubcategory}" Margin="8,0,0,0"
                            ToolTip="Crear una subcategoría dentro de la elegida (hereda sus especificaciones)" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" ToolTip="Categoría" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,12,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Nueva especificación" c:Ui.Icon="{x:Static c:Glyphs.Add}"
                            Command="{Binding NewSpec}" Height="32" />
                    <TextBlock Text="ESPECIFICACIONES (PROPIAS Y HEREDADAS)" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <ListBox ItemsSource="{Binding Specs}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainList}" MinHeight="300" MaxHeight="440">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SpecRow}">
                                <StackPanel Margin="4,6">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="6,0">
                                            <TextBlock Text="{Binding Code}" Style="{StaticResource Mono}" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap">
                                        <Run Text="{Binding TypeText, Mode=OneWay}" /> <Run Text="{Binding Flags, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding OptionsText}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding OptionsText, Converter={StaticResource HasValue}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Checklist}" Visibility="{Binding NoSpecs, Converter={StaticResource Visible}}">
                        <TextBlock Text="Esta categoría todavía no tiene especificaciones" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </ContentControl>
                </Grid>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16,14" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H3}" TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Código" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" c:Ui.Placeholder="socket" IsEnabled="{Binding IsNewSpec}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nombre visible" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" c:Ui.Placeholder="Socket" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" IsEnabled="{Binding IsNewSpec}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unidad" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" c:Ui.Placeholder="GB, W, mm" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="Varios valores" IsChecked="{Binding IsMultiValued}" IsEnabled="{Binding IsNewSpec}" Margin="0,0,14,6" />
                        <CheckBox Content="Filtrable" IsChecked="{Binding IsFilterable}" Margin="0,0,14,6" />
                        <CheckBox Content="Obligatoria" IsChecked="{Binding IsRequired}" Margin="0,0,14,6" />
                    </WrapPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Clave del armador de PC" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Keys}" SelectedItem="{Binding Key}" ToolTip="Solo para las especificaciones que usa la revisión de compatibilidad" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Orden" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Visibility="{Binding IsOptionType, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                        <TextBlock Text="Opciones (una por renglón, en este orden)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource MultilineTextBox}" Text="{Binding Options, UpdateSourceTrigger=PropertyChanged}" MinHeight="90" MaxHeight="150"
                                 c:Ui.Placeholder="AM5&#x0a;LGA1700" />
                    </StackPanel>
                    <Border Style="{StaticResource FormError}" Visibility="{Binding FormError, Converter={StaticResource HasValue}}">
                        <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Content="Guardar especificación" c:Ui.Icon="{x:Static c:Glyphs.Save}" Command="{Binding SaveSpec}"
                            Margin="0,14,0,0" HorizontalAlignment="Right" c:Ui.IsBusy="{Binding SaveSpec.IsRunning}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ============================================================================ cotización para la caja -->
    <DataTemplate DataType="{x:Type vm:PickBuildDialog}">
        <ListBox ItemsSource="{Binding Builds}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainList}" MaxHeight="420">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PcBuildItem}">
                    <DockPanel Margin="6,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" Background="{DynamicResource BrandSoft}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Mono}" Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5">
                                <Run Text="{Binding Customer, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ItemsText, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding ValidText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DataTemplate>

    <!-- ============================================================================ proforma del armado -->
    <DataTemplate DataType="{x:Type vm:ProformaDialog}">
        <StackPanel>
            <!-- Las acciones arriba: la proforma es larga y no deben quedar fuera de la vista -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button Content="Imprimir en la caja" c:Ui.Icon="{x:Static c:Glyphs.Printer}" Command="{Binding Print}" c:Ui.IsBusy="{Binding Print.IsRunning}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar PDF" c:Ui.Icon="{x:Static c:Glyphs.Download}" Command="{Binding SavePdf}" Margin="8,0,0,0" />
            </StackPanel>
            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="16,14"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================================ destino de una serie -->
    <DataTemplate DataType="{x:Type vm:DisposeSerialDialog}">
        <StackPanel>
            <TextBlock Text="Destino" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Disposal}" />
            <TextBlock Text="Motivo" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
            <ComboBox IsEditable="True" ItemsSource="{Binding Reasons}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Elija o escriba el motivo" />
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================================ series de stock existente -->
    <DataTemplate DataType="{x:Type vm:RegisterSerialsDialog}">
        <StackPanel>
            <TextBlock Text="Producto" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" IsTextSearchEnabled="True" TextSearch.TextPath="Name">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Sku, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text=" · " /><Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ContentControl Content="{Binding Line}" Focusable="False" Margin="0,12,0,0" />
            <TextBlock Text="Nota" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================================ abrir caso RMA -->
    <DataTemplate DataType="{x:Type vm:OpenClaimDialog}">
        <StackPanel>
            <TextBlock Text="Serie o IMEI del equipo" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Buscar" c:Ui.Icon="{x:Static c:Glyphs.Search}" Command="{Binding Lookup}" Margin="8,0,0,0"
                        c:Ui.IsBusy="{Binding Lookup.IsRunning}" />
                <TextBox Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Barcode}" MaxLength="80"
                         c:Ui.Placeholder="Escanee o escriba la serie (o el IMEI)" c:Ui.LostFocusCommand="{Binding Lookup}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding Lookup}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <Border CornerRadius="8" Padding="12,8" Margin="0,10,0,0" c:Ui.BrushKey="{Binding StatusSoftBrush}"
                    Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" c:Ui.BrushKey="{Binding StatusBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FormError}" Visibility="{Binding LookupError, Converter={StaticResource HasValue}}">
                <TextBlock Text="{Binding LookupError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="Falla que reporta el cliente" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
            <ComboBox IsEditable="True" ItemsSource="{Binding Issues}" Text="{Binding Issue, UpdateSourceTrigger=PropertyChanged}"
                      c:Ui.Placeholder="Describa la falla (mínimo 5 caracteres)" />
            <StackPanel Visibility="{Binding NeedsCustomer, Converter={StaticResource Visible}}" Margin="0,12,0,0">
                <TextBlock Text="Código del cliente (la venta es de otra sucursal)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="20" />
            </StackPanel>
            <Border Style="{StaticResource Panel}" Margin="0,14,0,0" Visibility="{Binding OutOfWarranty, Converter={StaticResource Visible}}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" Content="Reparación con cargo (fuera de garantía)" IsChecked="{Binding ChargeableRepair}" FontWeight="SemiBold" />
                    <TextBlock Text="La garantía venció: el caso se abre solo como servicio con cargo y queda marcado así." Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================================ avanzar caso RMA -->
    <DataTemplate DataType="{x:Type vm:MoveClaimDialog}">
        <StackPanel>
            <TextBlock Text="{Binding Help}" Style="{StaticResource Body}" TextWrapping="Wrap" />
            <StackPanel Visibility="{Binding NeedsSupplier, Converter={StaticResource Visible}}" Margin="0,12,0,0">
                <TextBlock Text="Proveedor o servicio técnico" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" />
            </StackPanel>
            <StackPanel Visibility="{Binding NeedsResolution, Converter={StaticResource Visible}}" Margin="0,12,0,0">
                <TextBlock Text="Resolución" Style="{StaticResource FieldLabel}" />
                <ComboBox IsEditable="True" ItemsSource="{Binding Resolutions}" Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}"
                          c:Ui.Placeholder="Qué se hizo o por qué no corresponde la garantía" />
            </StackPanel>
            <TextBlock Text="Nota (opcional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" c:Ui.Placeholder="Queda en la bitácora del caso" />
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================================ reemplazo con otra unidad -->
    <DataTemplate DataType="{x:Type vm:ReplaceClaimDialog}">
        <StackPanel>
            <ContentControl Content="{Binding Line}" Focusable="False" />
            <TextBlock Text="Resolución" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
