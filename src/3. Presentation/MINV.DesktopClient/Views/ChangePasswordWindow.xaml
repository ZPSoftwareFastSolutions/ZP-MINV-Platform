<Window x:Class="MINV.DesktopClient.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
        Title="Cambiar contraseña" Width="500" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource UiFont}" FontSize="13.5">
    <Border Margin="20" CornerRadius="16" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            Effect="{StaticResource PopupShadow}" Padding="28,24" MouseLeftButtonDown="OnDrag">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" Click="OnCancel" VerticalAlignment="Top"
                        ToolTip="Cerrar" Margin="0,-8,-12,0" />
                <Border Style="{StaticResource IconBubble}" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Key}" FontSize="18" />
                </Border>
            </DockPanel>
            <TextBlock Text="Cambiar contraseña" Style="{StaticResource H2}" Margin="0,14,0,6" />
            <TextBlock Text="{Binding Intro}" Style="{StaticResource Body}" Margin="0,0,0,18" />

            <TextBlock Text="Contraseña actual" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="Current" c:Ui.Icon="{x:Static c:Glyphs.Lock}" c:Ui.Placeholder="La que usa hoy" Margin="0,0,0,14" />
            <TextBlock Text="Nueva contraseña" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="Next" c:Ui.Icon="{x:Static c:Glyphs.Key}" c:Ui.Placeholder="Al menos 8 caracteres, con letras y números" Margin="0,0,0,14" />
            <TextBlock Text="Repita la nueva contraseña" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="Confirm" c:Ui.Icon="{x:Static c:Glyphs.Key}" c:Ui.Placeholder="Igual a la anterior" />

            <Border CornerRadius="10" Background="{DynamicResource DangerSoft}" Padding="12,10" Margin="0,16,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Error}" Foreground="{DynamicResource Danger}"
                               VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" FontSize="12.5" />
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancelar" MinWidth="110" Click="OnCancel" IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar contraseña" MinWidth="150" Margin="10,0,0,0" IsDefault="True"
                        Click="OnSave" c:Ui.IsBusy="{Binding IsBusy}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
