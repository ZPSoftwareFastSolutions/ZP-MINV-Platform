<UserControl x:Class="MINV.DesktopClient.Views.Pages.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <Grid Margin="28,6,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Content="Nuevo usuario" c:Ui.Icon="{x:Static c:Glyphs.Add}" Command="{Binding New}" Margin="0,0,8,0" />
                <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="4" Margin="-6,0,-6,10">
            <ContentControl Content="{Binding UsersKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding RolesKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding LockedKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding TodayKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
        </UniformGrid>

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <Border Background="{DynamicResource SurfaceHover}" CornerRadius="10" Padding="2" DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="Usuarios" c:Ui.Icon="{x:Static c:Glyphs.People}" IsChecked="{Binding IsUsers}" GroupName="usersTab" />
                    <RadioButton Style="{StaticResource Segment}" Content="Roles y funciones" c:Ui.Icon="{x:Static c:Glyphs.Shield}" IsChecked="{Binding IsRoles}" GroupName="usersTab" />
                    <RadioButton Style="{StaticResource Segment}" Content="Empresa" c:Ui.Icon="{x:Static c:Glyphs.Briefcase}" IsChecked="{Binding IsCompany}" GroupName="usersTab" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsUsers, Converter={StaticResource Visible}}">
                <TextBox Width="260" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}"
                         c:Ui.Placeholder="Buscar nombre o correo" Margin="0,0,10,0" />
                <ComboBox Width="190" ItemsSource="{Binding RoleFilters}" SelectedItem="{Binding Role}" ToolTip="Rol" />
            </StackPanel>
        </DockPanel>

        <!-- ========================================================================== usuarios -->
        <Border Grid.Row="3" Style="{StaticResource CardFlat}" Padding="4,2,4,4" Visibility="{Binding IsUsers, Converter={StaticResource Visible}}">
            <DataGrid ItemsSource="{Binding Rows}" RowHeight="58">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="USUARIO" Width="*" MinWidth="260" SortMemberPath="Name" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:UserItem}">
                                <DockPanel VerticalAlignment="Center">
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Background="{Binding Name, Converter={StaticResource AvatarBrush}}">
                                        <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="ROL" Width="170" SortMemberPath="RoleText" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:UserItem}">
                                <Border Style="{StaticResource Pill}" Background="{DynamicResource BrandSoft}">
                                    <TextBlock Text="{Binding RoleText}" Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="ESTADO" Width="160" SortMemberPath="StatusText" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:UserItem}">
                                <Border Style="{StaticResource StatusPill}" c:Ui.BrushKey="{Binding StatusSoftBrush}">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" c:Ui.BrushKey="{Binding StatusBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ÚLTIMO INGRESO" Binding="{Binding LastAccessText}" Width="150" SortMemberPath="Row.LastAccess" ElementStyle="{StaticResource CellText}" />
                    <DataGridTemplateColumn Width="96" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:UserItem}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="{x:Static c:Glyphs.Key}" ToolTip="Restablecer la contraseña"
                                            Command="{Binding DataContext.ResetPassword, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="{x:Static c:Glyphs.Settings}" ToolTip="Editar"
                                            Command="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ========================================================================== roles -->
        <ScrollViewer Grid.Row="3" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRoles, Converter={StaticResource Visible}}">
            <ItemsControl ItemsSource="{Binding Roles}" Focusable="False" Margin="-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RoleCard}">
                        <Border Style="{StaticResource Card}" Margin="8" Padding="18">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconBubble}" Width="36" Height="36">
                                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Shield}" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding UsersText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CountText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,12,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PermissionCheck}">
                                            <DockPanel Margin="0,3">
                                                <TextBlock x:Name="G" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Close}" FontSize="11"
                                                           Foreground="{DynamicResource TextFaint}" Width="18" />
                                                <TextBlock x:Name="D" Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="12" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Granted}" Value="True">
                                                    <Setter TargetName="G" Property="Text" Value="{x:Static c:Glyphs.Check}" />
                                                    <Setter TargetName="G" Property="Foreground" Value="{DynamicResource Success}" />
                                                    <Setter TargetName="D" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ========================================================================== empresa -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" HorizontalAlignment="Left" Width="620"
                Visibility="{Binding IsCompany, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock Text="{Binding Company.LegalName}" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                    <Run Text="Código de empresa:" /> <Run Text="{Binding Company.Code, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" · NIT" /> <Run Text="{Binding Company.TaxId, Mode=OneWay}" />
                    <Run Text=" · zona horaria" /> <Run Text="{Binding Company.TimeZoneId, Mode=OneWay}" />
                </TextBlock>
                <Border Height="1" Background="{DynamicResource Border}" Margin="0,16" />
                <TextBlock Text="Margen de alerta" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Margins}" SelectedItem="{Binding Margin}" />
                <TextBlock Text="Un producto pasa a «BAJO» cuando su stock queda a este porcentaje del mínimo (semáforo y pedido sugerido)."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="Días sin rotación" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <ComboBox ItemsSource="{Binding DaysOptions}" SelectedItem="{Binding Days}" />
                <TextBlock Text="Productos sin movimiento durante estos días aparecen como «sin rotación» en alertas y reportes."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar parámetros" c:Ui.Icon="{x:Static c:Glyphs.Save}" Command="{Binding SaveCompany}"
                        HorizontalAlignment="Left" Margin="0,18,0,0" c:Ui.IsBusy="{Binding SaveCompany.IsRunning}" />
            </StackPanel>
        </Border>

        <!-- ========================================================================== editor -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource EditorPanel}" Width="420"
                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}"
                DataContext="{Binding Editor}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,16,12,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" Command="{Binding Cancel}" />
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding Save}" MinWidth="130"
                                c:Ui.IsBusy="{Binding Save.IsRunning}" c:Ui.Icon="{x:Static c:Glyphs.Save}" />
                        <Button Content="Cancelar" Command="{Binding Cancel}" HorizontalAlignment="Left" />
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,4,20,16">
                        <TextBlock Text="Nombre completo" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" c:Ui.Icon="{x:Static c:Glyphs.Person}" />
                        <TextBlock Text="Correo (usuario de ingreso)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" c:Ui.Icon="{x:Static c:Glyphs.Mail}" />
                        <TextBlock Text="Rol" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" />
                        <CheckBox Style="{StaticResource Switch}" Content="Usuario activo (puede ingresar)" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />
                        <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Visibility="{Binding IsNew, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="Contraseña temporal" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Regenerate}"
                                            ToolTip="Generar otra" />
                                    <TextBlock Text="{Binding Password}" Style="{StaticResource Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Se muestra al crear el usuario para entregarla; la persona la cambia en su primer ingreso." Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FormError}" Visibility="{Binding Error, Converter={StaticResource HasValue}}">
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
