<UserControl x:Class="MINV.DesktopClient.Views.Pages.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <UserControl.Resources>
        <!-- Producto de la cuadrícula -->
        <DataTemplate x:Key="PosTile" DataType="{x:Type vm:PosProduct}">
            <Button x:Name="Tile" Style="{StaticResource CardButton}" Padding="0" Width="164" Margin="6" ToolTip="{Binding Name}"
                    Command="{Binding DataContext.Add, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Height="112" Margin="7,7,7,0">
                        <c:ProductThumb Source="{Binding Image}" CornerRadius="9" />
                        <Border x:Name="Out" Background="{DynamicResource Overlay}" CornerRadius="9" Visibility="Collapsed">
                            <TextBlock Text="AGOTADO" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- V4.2 · Lleva serie o IMEI: al agregarlo se elige la unidad -->
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="6,1"
                                Visibility="{Binding HasSerialBadge, Converter={StaticResource Visible}}" ToolTip="Al agregarlo se elige la unidad (serie o IMEI)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Barcode}" FontSize="10" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding SerialBadge}" />
                            </StackPanel>
                        </Border>
                        <!-- V4.2 · Plataformas (opciones de la especificación) -->
                        <ItemsControl ItemsSource="{Binding Platforms}" Focusable="False" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"
                                      ItemsPanel="{StaticResource WrapPanelTemplate}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PlatformBadge}" Margin="0,0,3,0" Background="{DynamicResource Surface}">
                                        <TextBlock Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <StackPanel Margin="10,8,10,10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Height="34"
                                   TextTrimming="CharacterEllipsis" FontSize="12.5" LineHeight="17" LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding PriceText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrandText}" Margin="0,4,0,0" />
                        <TextBlock x:Name="Avail" Text="{Binding AvailableText}" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOut}" Value="True">
                    <Setter TargetName="Out" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Tile" Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLow}" Value="True">
                    <Setter TargetName="Avail" Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Línea del carrito -->
        <DataTemplate x:Key="CartRow" DataType="{x:Type vm:CartLine}">
            <Border Padding="0,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:ProductThumb Width="44" Height="44" Source="{Binding Image}" CornerRadius="8" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="10,0,6,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding UnitPriceText}" Style="{StaticResource Caption}" FontSize="11.5" />
                        <!-- V4.2 · Series o IMEI de la línea -->
                        <DockPanel Margin="0,4,0,0" Visibility="{Binding IsSerialized, Converter={StaticResource Visible}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Elegir" VerticalAlignment="Top" Margin="6,0,0,0"
                                    Command="{Binding DataContext.EditSerials, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    ToolTip="Elegir o cambiar las unidades (series o IMEI)" />
                            <TextBlock Text="{Binding SerialsText}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource BrandText}" TextWrapping="Wrap"
                                       Visibility="{Binding HasSerials, Converter={StaticResource Visible}}" />
                        </DockPanel>
                        <TextBlock Text="{Binding SerialsNeeded}" Foreground="{DynamicResource Warning}" FontSize="11.5" Margin="0,2,0,0"
                                   Visibility="{Binding MissingSerials, Converter={StaticResource Visible}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsEditable, Converter={StaticResource Visible}}">
                            <Button Width="28" Height="28" Padding="0" FontFamily="{StaticResource IconFont}" FontSize="10" Content="{x:Static c:Glyphs.Remove}"
                                    Command="{Binding DataContext.Decrease, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <TextBox Width="54" Height="28" Margin="4,0" TextAlignment="Center" Padding="2,0" c:Ui.SelectAllOnFocus="True"
                                     Text="{Binding QuantityText, UpdateSourceTrigger=LostFocus}" c:Ui.HasError="{Binding ExceedsStock}" IsReadOnly="{Binding IsSerialized}"
                                     ToolTip="Con serie o IMEI la cantidad es la de las unidades elegidas" />
                            <Button Width="28" Height="28" Padding="0" FontFamily="{StaticResource IconFont}" FontSize="10" Content="{x:Static c:Glyphs.Add}"
                                    Command="{Binding DataContext.Increase, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <TextBlock Text="Desc." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <ComboBox Width="74" Height="28" MinHeight="0" Padding="8,0" ItemsSource="{x:Static vm:CartLine.Discounts}"
                                      SelectedItem="{Binding Discount}" ItemStringFormat="{}{0} %" ToolTip="Descuento de la línea" />
                        </StackPanel>
                        <TextBlock Text="Supera lo disponible" Foreground="{DynamicResource Danger}" FontSize="11.5" Margin="0,4,0,0"
                                   Visibility="{Binding ExceedsStock, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding AmountText}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" />
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="{x:Static c:Glyphs.Delete}" HorizontalAlignment="Right"
                                Margin="0,8,0,0" ToolTip="Quitar del carrito" Foreground="{DynamicResource Danger}"
                                Command="{Binding DataContext.Remove, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsEditable, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Quantity, StringFormat='× {0:0.###}'}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,6,0,0"
                                   Visibility="{Binding IsLocked, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,6,24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="410" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- V4.1 · Banda de estado fiscal (solo si la empresa factura) -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="10" Padding="14,8" Margin="0,0,0,12" c:Ui.BrushKey="{Binding FiscalSoftBrush}"
                Visibility="{Binding IsBilling, Converter={StaticResource Visible}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding FiscalGlyph}" FontSize="16" Margin="0,0,10,0" c:Ui.BrushKey="{Binding FiscalBrush}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding FiscalTitle}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"
                           c:Ui.BrushKey="{Binding FiscalBrush}" />
                <TextBlock Text="{Binding FiscalDetail}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FiscalDetail}" />
            </DockPanel>
        </Border>

        <!-- Encabezado y estado de la caja -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)"
                    VerticalAlignment="Center" Margin="8,0,0,0" />
            <!-- Caja abierta -->
            <Border DockPanel.Dock="Right" Background="{DynamicResource SuccessSoft}" CornerRadius="12" Padding="14,8" VerticalAlignment="Center"
                    Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.CheckCircle}" Foreground="{DynamicResource Success}" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Success}" />
                        <TextBlock Text="{Binding SessionText}" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                    <Button Content="Cerrar caja" c:Ui.Icon="{x:Static c:Glyphs.Lock}" Command="{Binding CloseSession}" Height="34" />
                </StackPanel>
            </Border>
            <!-- Caja cerrada -->
            <Border DockPanel.Dock="Right" Background="{DynamicResource WarningSoft}" CornerRadius="12" Padding="14,8" VerticalAlignment="Center"
                    Visibility="{Binding IsClosed, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Lock}" Foreground="{DynamicResource Warning}" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="Caja cerrada" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" Margin="10,0,12,0" VerticalAlignment="Center" />
                    <ComboBox Width="170" Height="34" MinHeight="0" ItemsSource="{Binding Registers}" SelectedItem="{Binding Register}" DisplayMemberPath="Name"
                              ToolTip="Caja" />
                    <ComboBox Width="120" Height="34" MinHeight="0" Margin="8,0" IsEditable="True" ItemsSource="{Binding OpeningOptions}"
                              Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fondo inicial en efectivo" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Abrir caja" c:Ui.Icon="{x:Static c:Glyphs.CheckCircle}" Command="{Binding OpenSession}" Height="34"
                            c:Ui.IsBusy="{Binding OpenSession.IsRunning}" />
                </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Productos -->
        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,16,8">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}" MinHeight="44" FontSize="14"
                         c:Ui.Placeholder="Buscar producto por nombre, SKU o código de barras (o léalo con el escáner)" />
                <ItemsControl ItemsSource="{Binding CategoryChips}" ItemTemplate="{StaticResource FilterChipTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                              Focusable="False" Margin="0,10,0,0" ClipToBounds="True">
                    <!-- V4.2 · Con muchas categorías se muestran dos filas y «Ver todas las categorías» despliega el resto -->
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CollapseCategories}" Value="True">
                                    <Setter Property="MaxHeight" Value="78" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
                <Button Style="{StaticResource LinkButton}" Content="{Binding MoreCategoriesText}" Command="{Binding ToggleCategories}" HorizontalAlignment="Left"
                        Margin="2,0,0,8" Visibility="{Binding HasManyCategories, Converter={StaticResource Visible}}" />
                <!-- V4.2 · Plataforma (opciones de la especificación «Plataforma», regla T-07) -->
                <ItemsControl ItemsSource="{Binding PlatformChips}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False"
                              Visibility="{Binding HasPlatforms, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FilterChip}">
                            <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=OneWay}" Margin="0,0,6,6"
                                         Command="{Binding DataContext.SelectPlatform, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Monitor}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource SurfaceHover}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0" MinWidth="22">
                                        <TextBlock Text="{Binding Count}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Grid Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-6,0,0,0">
                    <ItemsControl ItemsSource="{Binding Products}" ItemTemplate="{StaticResource PosTile}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                  Focusable="False" />
                </ScrollViewer>
                <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Search}" Visibility="{Binding NoProducts, Converter={StaticResource Visible}}">
                    <TextBlock Text="Ningún producto con precio coincide con la búsqueda" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                </ContentControl>
            </Grid>
        </DockPanel>

        <!-- Carrito y cobro -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,14,12,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Vaciar" c:Ui.Icon="{x:Static c:Glyphs.Delete}" Command="{Binding ClearCart}"
                            Height="30" Padding="10,0" />
                    <!-- V4.2 · Cobrar una cotización del armador de PC -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Desde armado" c:Ui.Icon="{x:Static c:Glyphs.Monitor}"
                            Command="{Binding FromBuild}" Height="30" Padding="10,0" Margin="0,0,4,0" c:Ui.IsBusy="{Binding FromBuild.IsRunning}"
                            ToolTip="Cargar una cotización vigente del armador de PC (precios cotizados y series de cada pieza)" />
                    <StackPanel>
                        <TextBlock Text="Venta actual" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding ItemsText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>

                <!-- V4.2 · Armado cotizado en el carrito -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BrandSoft}" BorderBrush="{DynamicResource Brand}" BorderThickness="0,1,0,1" Padding="18,8"
                        Visibility="{Binding IsBuildMode, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Quitar" Command="{Binding ClearBuild}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Monitor}" FontSize="16" Foreground="{DynamicResource BrandText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding BuildTitle}" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding BuildDetail}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- V4.1 · Datos de facturación del comprador (nominatividad) -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1" Padding="18,8,18,10"
                        Visibility="{Binding IsBilling, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleBuyer}" Height="28" Padding="0" HorizontalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" ToolTip="Mostrar u ocultar los datos de facturación">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.ChevronDown}" FontSize="10" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Invoice}" FontSize="13" Margin="0,0,8,0"
                                           Foreground="{DynamicResource BrandText}" />
                                <TextBlock Text="Datos de facturación" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <ContentControl Content="{Binding Buyer}" Focusable="False" Margin="0,6,0,0"
                                        Visibility="{Binding IsBuyerExpanded, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>

                <!-- Cobro -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12" Padding="18,12,18,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cliente" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" IsTextSearchEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Medio de pago" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" DisplayMemberPath="Name" />
                            </StackPanel>
                        </Grid>
                        <!-- Efectivo -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsCash, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Button Content="Exacto" Command="{Binding QuickCash}" CommandParameter="exacto" Height="34" Padding="10,0" />
                                    <Button Content="50" Command="{Binding QuickCash}" CommandParameter="50" Height="34" Padding="10,0" Margin="4,0,0,0" />
                                    <Button Content="100" Command="{Binding QuickCash}" CommandParameter="100" Height="34" Padding="10,0" Margin="4,0,0,0" />
                                    <Button Content="200" Command="{Binding QuickCash}" CommandParameter="200" Height="34" Padding="10,0" Margin="4,0,0,0" />
                                </StackPanel>
                                <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Efectivo recibido" c:Ui.SelectAllOnFocus="True"
                                         c:Ui.Icon="{x:Static c:Glyphs.Money}" c:Ui.HasError="{Binding CashShort}" />
                            </DockPanel>
                            <TextBlock Text="{Binding ChangeText}" FontWeight="SemiBold" Foreground="{DynamicResource Success}" Margin="0,6,0,0" />
                        </StackPanel>
                        <!-- Otros medios -->
                        <TextBox Margin="0,10,0,0" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="N.º de operación, voucher o referencia"
                                 c:Ui.Icon="{x:Static c:Glyphs.Report}" Visibility="{Binding NeedsReference, Converter={StaticResource Visible}}" />
                        <!-- V4.1 · Tarjeta: se envía al cobrar y se borra; la factura la lleva enmascarada -->
                        <TextBox Margin="0,8,0,0" Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="23" c:Ui.Icon="{x:Static c:Glyphs.Money}"
                                 c:Ui.Placeholder="N.º de tarjeta (va enmascarado en la factura)" Visibility="{Binding IsCard, Converter={StaticResource Visible}}"
                                 AutomationProperties.Name="Número de tarjeta" />

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,12" />
                        <TextBlock Text="{Binding DiscountText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                   Visibility="{Binding DiscountText, Converter={StaticResource HasValue}}" />
                        <DockPanel>
                            <TextBlock Text="{Binding TotalText}" DockPanel.Dock="Right" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding TaxText}" Style="{StaticResource Caption}" FontSize="11.5" />
                            </StackPanel>
                        </DockPanel>
                        <Button Style="{StaticResource PrimaryButton}" Height="52" FontSize="16" Margin="0,12,0,0" Content="{Binding CheckoutText}"
                                Command="{Binding Checkout}" c:Ui.IsBusy="{Binding Checkout.IsRunning}" c:Ui.Icon="{x:Static c:Glyphs.CheckCircle}" />
                        <!-- Última venta -->
                        <Border Background="{DynamicResource BrandSoft}" CornerRadius="8" Padding="10,6" Margin="0,10,0,0"
                                Visibility="{Binding HasLastSale, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="{x:Static c:Glyphs.Printer}"
                                        Command="{Binding PrintReceipt}" ToolTip="Imprimir o ver el ticket" />
                                <TextBlock Text="{Binding LastSaleText}" Foreground="{DynamicResource BrandText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,14,0">
                        <ItemsControl ItemsSource="{Binding Cart}" ItemTemplate="{StaticResource CartRow}" Focusable="False" />
                    </ScrollViewer>
                    <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Cart}" Visibility="{Binding IsCartEmpty, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="Toque un producto para agregarlo" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="o léalo con el escáner" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </ContentControl>
                </Grid>
            </DockPanel>
        </Border>

        <!-- V4.1 · Resultado fiscal del cobro: documento definitivo, ticket con QR y entregas -->
        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="{Binding IsFiscalResultOpen, Converter={StaticResource Visible}}" Margin="-24,-6,-24,-18">
            <Border Background="{DynamicResource Overlay}" />
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" Margin="0,24" Effect="{StaticResource PopupShadow}"
                    DataContext="{Binding FiscalResult}" MaxWidth="1000">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" VerticalAlignment="Top"
                                Command="{Binding DataContext.CloseFiscalResult, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" c:Ui.BrushKey="{Binding StatusSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" c:Ui.BrushKey="{Binding StatusBrush}" />
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Imprimir otra vez" c:Ui.Icon="{x:Static c:Glyphs.Printer}" Command="{Binding PrintAgain}" c:Ui.IsBusy="{Binding PrintAgain.IsRunning}" />
                        <Button Content="Ver PDF" c:Ui.Icon="{x:Static c:Glyphs.Invoice}" Command="{Binding ViewPdf}" Margin="8,0,0,0" c:Ui.IsBusy="{Binding ViewPdf.IsRunning}" />
                        <Button Content="Enviar por correo" c:Ui.Icon="{x:Static c:Glyphs.Mail}" Command="{Binding SendEmail}" Margin="8,0,0,0" />
                        <Button Content="Ver el documento" c:Ui.Icon="{x:Static c:Glyphs.Search}" Command="{Binding OpenDocument}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Corregir y re-emitir" c:Ui.Icon="{x:Static c:Glyphs.Refresh}" Command="{Binding Reissue}"
                                Margin="8,0,0,0" Visibility="{Binding IsRejected, Converter={StaticResource Visible}}" c:Ui.IsBusy="{Binding Reissue.IsRunning}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Siguiente venta" Margin="8,0,0,0" IsDefault="True"
                                Command="{Binding DataContext.CloseFiscalResult, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Ticket fiscal (vista previa del rollo) -->
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="14,12"
                                MaxHeight="560">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <StackPanel>
                                    <TextBlock Text="{Binding TicketText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                                    <Border Width="132" Height="132" Margin="0,10,0,0" HorizontalAlignment="Center"
                                            Visibility="{Binding QrUrl, Converter={StaticResource HasValue}}">
                                        <c:QrCode Text="{Binding QrUrl}" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Grid.Column="2" MinWidth="320" MaxWidth="420">
                            <Border Style="{StaticResource StatusPill}" c:Ui.BrushKey="{Binding StatusSoftBrush}">
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" c:Ui.BrushKey="{Binding StatusBrush}" />
                            </Border>
                            <TextBlock Text="CUF" Style="{StaticResource Overline}" Margin="0,12,0,2" />
                            <TextBlock Text="{Binding Cuf}" Style="{StaticResource Mono}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="COMPRADOR" Style="{StaticResource Overline}" Margin="0,12,0,2" />
                            <TextBlock Text="{Binding BuyerText}" TextWrapping="Wrap" />
                            <TextBlock Text="VENTA" Style="{StaticResource Overline}" Margin="0,12,0,2" />
                            <TextBlock Text="{Binding SaleText}" TextWrapping="Wrap" />
                            <Border Style="{StaticResource FormError}" Visibility="{Binding HasMessages, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="MENSAJES DEL SIN" Style="{StaticResource Overline}" Foreground="{DynamicResource Danger}" />
                                    <TextBlock Text="{Binding Messages}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource InfoSoft}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                                    Visibility="{Binding Notice, Converter={StaticResource HasValue}}">
                                <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Info}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding PrintText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Ticket en pantalla -->
        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="{Binding IsReceiptOpen, Converter={StaticResource Visible}}" Margin="-24,-6,-24,-18">
            <Border Background="{DynamicResource Overlay}" />
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" Effect="{StaticResource PopupShadow}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" Command="{Binding CloseReceipt}" />
                        <TextBlock Text="Ticket de venta" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                        <TextBlock Text="{Binding ReceiptText}" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Imprimir" c:Ui.Icon="{x:Static c:Glyphs.Printer}" Command="{Binding PrintReceipt}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Siguiente venta" Command="{Binding CloseReceipt}" Margin="8,0,0,0" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
