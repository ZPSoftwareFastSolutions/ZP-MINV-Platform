<UserControl x:Class="MINV.DesktopClient.Views.Pages.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <UserControl.Resources>
        <!-- Producto de la cuadrícula -->
        <DataTemplate x:Key="PosTile" DataType="{x:Type vm:PosProduct}">
            <Button x:Name="Tile" Style="{StaticResource CardButton}" Padding="0" Width="164" Margin="6" ToolTip="{Binding Name}"
                    Command="{Binding DataContext.Add, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Height="112" Margin="7,7,7,0">
                        <c:ProductThumb Source="{Binding Image}" CornerRadius="9" />
                        <Border x:Name="Out" Background="{DynamicResource Overlay}" CornerRadius="9" Visibility="Collapsed">
                            <TextBlock Text="AGOTADO" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="10,8,10,10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Height="34"
                                   TextTrimming="CharacterEllipsis" FontSize="12.5" LineHeight="17" LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding PriceText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrandText}" Margin="0,4,0,0" />
                        <TextBlock x:Name="Avail" Text="{Binding AvailableText}" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOut}" Value="True">
                    <Setter TargetName="Out" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Tile" Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLow}" Value="True">
                    <Setter TargetName="Avail" Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Línea del carrito -->
        <DataTemplate x:Key="CartRow" DataType="{x:Type vm:CartLine}">
            <Border Padding="0,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:ProductThumb Width="44" Height="44" Source="{Binding Image}" CornerRadius="8" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="10,0,6,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding UnitPriceText}" Style="{StaticResource Caption}" FontSize="11.5" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Width="28" Height="28" Padding="0" FontFamily="{StaticResource IconFont}" FontSize="10" Content="{x:Static c:Glyphs.Remove}"
                                    Command="{Binding DataContext.Decrease, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <TextBox Width="54" Height="28" Margin="4,0" TextAlignment="Center" Padding="2,0" c:Ui.SelectAllOnFocus="True"
                                     Text="{Binding QuantityText, UpdateSourceTrigger=LostFocus}" c:Ui.HasError="{Binding ExceedsStock}" />
                            <Button Width="28" Height="28" Padding="0" FontFamily="{StaticResource IconFont}" FontSize="10" Content="{x:Static c:Glyphs.Add}"
                                    Command="{Binding DataContext.Increase, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <TextBlock Text="Desc." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <ComboBox Width="74" Height="28" MinHeight="0" Padding="8,0" ItemsSource="{x:Static vm:CartLine.Discounts}"
                                      SelectedItem="{Binding Discount}" ItemStringFormat="{}{0} %" ToolTip="Descuento de la línea" />
                        </StackPanel>
                        <TextBlock Text="Supera lo disponible" Foreground="{DynamicResource Danger}" FontSize="11.5" Margin="0,4,0,0"
                                   Visibility="{Binding ExceedsStock, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding AmountText}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" />
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="{x:Static c:Glyphs.Delete}" HorizontalAlignment="Right"
                                Margin="0,8,0,0" ToolTip="Quitar del carrito" Foreground="{DynamicResource Danger}"
                                Command="{Binding DataContext.Remove, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,6,24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="410" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado y estado de la caja -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)"
                    VerticalAlignment="Center" Margin="8,0,0,0" />
            <!-- Caja abierta -->
            <Border DockPanel.Dock="Right" Background="{DynamicResource SuccessSoft}" CornerRadius="12" Padding="14,8" VerticalAlignment="Center"
                    Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.CheckCircle}" Foreground="{DynamicResource Success}" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Success}" />
                        <TextBlock Text="{Binding SessionText}" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                    <Button Content="Cerrar caja" c:Ui.Icon="{x:Static c:Glyphs.Lock}" Command="{Binding CloseSession}" Height="34" />
                </StackPanel>
            </Border>
            <!-- Caja cerrada -->
            <Border DockPanel.Dock="Right" Background="{DynamicResource WarningSoft}" CornerRadius="12" Padding="14,8" VerticalAlignment="Center"
                    Visibility="{Binding IsClosed, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Lock}" Foreground="{DynamicResource Warning}" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="Caja cerrada" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" Margin="10,0,12,0" VerticalAlignment="Center" />
                    <ComboBox Width="170" Height="34" MinHeight="0" ItemsSource="{Binding Registers}" SelectedItem="{Binding Register}" DisplayMemberPath="Name"
                              ToolTip="Caja" />
                    <ComboBox Width="120" Height="34" MinHeight="0" Margin="8,0" IsEditable="True" ItemsSource="{Binding OpeningOptions}"
                              Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fondo inicial en efectivo" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Abrir caja" c:Ui.Icon="{x:Static c:Glyphs.CheckCircle}" Command="{Binding OpenSession}" Height="34"
                            c:Ui.IsBusy="{Binding OpenSession.IsRunning}" />
                </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Productos -->
        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,16,8">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}" MinHeight="44" FontSize="14"
                         c:Ui.Placeholder="Buscar producto por nombre, SKU o código de barras (o léalo con el escáner)" />
                <ItemsControl ItemsSource="{Binding CategoryChips}" ItemTemplate="{StaticResource FilterChipTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                              Focusable="False" Margin="0,10,0,0" />
            </StackPanel>
            <Grid Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-6,0,0,0">
                    <ItemsControl ItemsSource="{Binding Products}" ItemTemplate="{StaticResource PosTile}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                  Focusable="False" />
                </ScrollViewer>
                <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Search}" Visibility="{Binding NoProducts, Converter={StaticResource Visible}}">
                    <TextBlock Text="Ningún producto con precio coincide con la búsqueda" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                </ContentControl>
            </Grid>
        </DockPanel>

        <!-- Carrito y cobro -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,14,12,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Vaciar" c:Ui.Icon="{x:Static c:Glyphs.Delete}" Command="{Binding ClearCart}"
                            Height="30" Padding="10,0" />
                    <StackPanel>
                        <TextBlock Text="Venta actual" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding ItemsText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>

                <!-- Cobro -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12" Padding="18,12,18,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cliente" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" IsTextSearchEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Medio de pago" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" DisplayMemberPath="Name" />
                            </StackPanel>
                        </Grid>
                        <!-- Efectivo -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsCash, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Button Content="Exacto" Command="{Binding QuickCash}" CommandParameter="exacto" Height="34" Padding="10,0" />
                                    <Button Content="50" Command="{Binding QuickCash}" CommandParameter="50" Height="34" Padding="10,0" Margin="4,0,0,0" />
                                    <Button Content="100" Command="{Binding QuickCash}" CommandParameter="100" Height="34" Padding="10,0" Margin="4,0,0,0" />
                                    <Button Content="200" Command="{Binding QuickCash}" CommandParameter="200" Height="34" Padding="10,0" Margin="4,0,0,0" />
                                </StackPanel>
                                <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Efectivo recibido" c:Ui.SelectAllOnFocus="True"
                                         c:Ui.Icon="{x:Static c:Glyphs.Money}" c:Ui.HasError="{Binding CashShort}" />
                            </DockPanel>
                            <TextBlock Text="{Binding ChangeText}" FontWeight="SemiBold" Foreground="{DynamicResource Success}" Margin="0,6,0,0" />
                        </StackPanel>
                        <!-- Otros medios -->
                        <TextBox Margin="0,10,0,0" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="N.º de operación, voucher o referencia"
                                 c:Ui.Icon="{x:Static c:Glyphs.Report}" Visibility="{Binding NeedsReference, Converter={StaticResource Visible}}" />

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,12" />
                        <TextBlock Text="{Binding DiscountText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                   Visibility="{Binding DiscountText, Converter={StaticResource HasValue}}" />
                        <DockPanel>
                            <TextBlock Text="{Binding TotalText}" DockPanel.Dock="Right" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding TaxText}" Style="{StaticResource Caption}" FontSize="11.5" />
                            </StackPanel>
                        </DockPanel>
                        <Button Style="{StaticResource PrimaryButton}" Height="52" FontSize="16" Margin="0,12,0,0" Content="{Binding CheckoutText}"
                                Command="{Binding Checkout}" c:Ui.IsBusy="{Binding Checkout.IsRunning}" c:Ui.Icon="{x:Static c:Glyphs.CheckCircle}" />
                        <!-- Última venta -->
                        <Border Background="{DynamicResource BrandSoft}" CornerRadius="8" Padding="10,6" Margin="0,10,0,0"
                                Visibility="{Binding HasLastSale, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="{x:Static c:Glyphs.Printer}"
                                        Command="{Binding PrintReceipt}" ToolTip="Imprimir o ver el ticket" />
                                <TextBlock Text="{Binding LastSaleText}" Foreground="{DynamicResource BrandText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,14,0">
                        <ItemsControl ItemsSource="{Binding Cart}" ItemTemplate="{StaticResource CartRow}" Focusable="False" />
                    </ScrollViewer>
                    <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Cart}" Visibility="{Binding IsCartEmpty, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="Toque un producto para agregarlo" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="o léalo con el escáner" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </ContentControl>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Ticket en pantalla -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="{Binding IsReceiptOpen, Converter={StaticResource Visible}}" Margin="-24,-6,-24,-18">
            <Border Background="{DynamicResource Overlay}" />
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" Effect="{StaticResource PopupShadow}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" Command="{Binding CloseReceipt}" />
                        <TextBlock Text="Ticket de venta" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                        <TextBlock Text="{Binding ReceiptText}" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Imprimir" c:Ui.Icon="{x:Static c:Glyphs.Printer}" Command="{Binding PrintReceipt}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Siguiente venta" Command="{Binding CloseReceipt}" Margin="8,0,0,0" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
