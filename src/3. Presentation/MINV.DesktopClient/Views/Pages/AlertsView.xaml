<UserControl x:Class="MINV.DesktopClient.Views.Pages.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels"
             xmlns:inv="clr-namespace:MINV.Domain.Inventory;assembly=MINV.Domain">
    <Grid Margin="28,6,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SoftButton}" Content="Ver pedido sugerido" c:Ui.Icon="{x:Static c:Glyphs.Cart}" Command="{Binding GoOrder}"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="Ordenadas por urgencia, igual que 16_ALERTAS de la V2.1" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,12">
            <Border Style="{StaticResource CardFlat}" Margin="6" Padding="16,12" BorderBrush="{DynamicResource StatusOutOfStockSoft}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Background="{DynamicResource StatusOutOfStock}" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Agotados" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OutOfStock}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Reabastecer de inmediato" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardFlat}" Margin="6" Padding="16,12">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Background="{DynamicResource StatusCritical}" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Críticos" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Critical}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Emitir orden de compra" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardFlat}" Margin="6" Padding="16,12">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Background="{DynamicResource StatusLow}" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Bajos" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Low}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Programar reposición" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardFlat}" Margin="6" Padding="16,12">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Background="{DynamicResource StatusOverstock}" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Sobrestock e inconsistentes" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Other}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Revisar y ajustar" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource FilterChipTemplate}"
                      ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" Margin="0,0,0,6" />

        <Grid Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AlertItem}">
                        <Border Style="{StaticResource CardFlat}" Padding="0" Margin="0,0,4,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" CornerRadius="12,0,0,12" Background="{DynamicResource StatusLow}" />
                                <TextBlock Grid.Column="1" Text="{Binding Position, StringFormat='#{0}'}" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Margin="0,14" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                        <c:StatusBadge Status="{Binding Status}" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Sku, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Supplier, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock>
                                        <Run Text="{Binding StockText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <Run Text="{Binding MinimumText, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                    </TextBlock>
                                    <c:LevelBar Value="{Binding Level}" Status="{Binding Status}" Margin="0,6,20,0" />
                                    <TextBlock Text="{Binding ShortfallText}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                        <Run Text="Sugerido:" /> <Run Text="{Binding SuggestedText, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Button Style="{StaticResource SoftButton}" Content="Registrar entrada" c:Ui.Icon="{x:Static c:Glyphs.Add}" Height="34"
                                            Command="{Binding DataContext.Replenish, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,6,0"
                                            Visibility="{Binding IsReplenishable, Converter={StaticResource Visible}}" />
                                    <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Eye}" ToolTip="Ver ficha y kardex"
                                            Command="{Binding DataContext.OpenProduct, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static inv:StockStatusCode.OutOfStock}">
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource StatusOutOfStock}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static inv:StockStatusCode.Critical}">
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource StatusCritical}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static inv:StockStatusCode.Overstock}">
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource StatusOverstock}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static inv:StockStatusCode.Inconsistent}">
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource StatusInconsistent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.CheckCircle}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="¡Todo en orden!" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Ningún producto está agotado, crítico, bajo ni con sobrestock." HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
