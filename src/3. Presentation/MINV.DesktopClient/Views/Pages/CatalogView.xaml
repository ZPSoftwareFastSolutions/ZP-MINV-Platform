<UserControl x:Class="MINV.DesktopClient.Views.Pages.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <UserControl.Resources>
        <!-- Tarjeta de la galería -->
        <DataTemplate x:Key="ProductTile" DataType="{x:Type vm:CatalogProduct}">
            <Button Style="{StaticResource CardButton}" Padding="0" Width="206" Margin="7" ToolTip="{Binding Name}"
                    Command="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Height="142" Margin="8,8,8,0">
                        <c:ProductThumb Source="{Binding Image}" Glyph="{x:Static c:Glyphs.Box}" CornerRadius="10" />
                        <c:StatusBadge Status="{Binding Status}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" />
                        <!-- V4.2 · Lleva serie o IMEI -->
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Visibility="{Binding HasSerialBadge, Converter={StaticResource Visible}}" ToolTip="Cada unidad se vende con su serie o IMEI">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Barcode}" FontSize="10" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding SerialBadge}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Overlay}" CornerRadius="10" Visibility="{Binding IsActive, Converter={StaticResource Hidden}}">
                            <TextBlock Text="INACTIVO" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="12,10,12,12">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Height="36"
                                   TextTrimming="CharacterEllipsis" LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                        <!-- V4.2 · Garantía y plataformas (una fila fija para que todas las tarjetas midan lo mismo) -->
                        <WrapPanel Height="22" Margin="0,5,0,0" ClipToBounds="True">
                            <Border Style="{StaticResource Badge}" Margin="0,0,4,0" Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource Success}"
                                    TextElement.Foreground="{DynamicResource Success}" Visibility="{Binding HasWarrantyBadge, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding WarrantyBadge}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Platforms}" Focusable="False" ItemsPanel="{StaticResource WrapPanelTemplate}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PlatformBadge}" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <!-- El precio completo siempre visible (columna Auto); el SKU toma lo que queda y se recorta con «…» -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PriceText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrandText}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="6,1" Margin="8,0,0,0" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" ToolTip="{Binding Sku}">
                                <TextBlock Text="{Binding Sku}" Style="{StaticResource Mono}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="11.5">
                                <Run Text="Margen" /> <Run Text="{Binding MarginText, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="{Binding StockText}" Style="{StaticResource Caption}" FontSize="11.5" />
                        </DockPanel>
                        <c:LevelBar Value="{Binding Level}" Status="{Binding Status}" Margin="0,7,0,0" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,6,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="10" Padding="2" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Galería" c:Ui.Icon="{x:Static c:Glyphs.Sparkle}" IsChecked="{Binding IsGallery}"
                                     GroupName="catalogView" />
                        <RadioButton Style="{StaticResource Segment}" Content="Lista" c:Ui.Icon="{x:Static c:Glyphs.Menu}" IsChecked="{Binding IsList}"
                                     GroupName="catalogView" />
                    </StackPanel>
                </Border>
                <Button Content="Exportar" c:Ui.Icon="{x:Static c:Glyphs.Download}" Command="{Binding Export}" Margin="0,0,8,0" />
                <Button Content="Especificaciones" c:Ui.Icon="{x:Static c:Glyphs.Checklist}" Command="{Binding ManageSpecs}" Margin="0,0,8,0"
                        ToolTip="Especificaciones técnicas por categoría (fichas, filtros y armador de PC)" c:Ui.IsBusy="{Binding ManageSpecs.IsRunning}"
                        Visibility="{Binding CanManageSpecs, Converter={StaticResource Visible}}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Nuevo producto" c:Ui.Icon="{x:Static c:Glyphs.Add}" Command="{Binding New}"
                        Margin="0,0,8,0" Visibility="{Binding CanEdit, Converter={StaticResource Visible}}" />
                <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Indicadores -->
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="4" Margin="-6,0,-6,10">
            <ContentControl Content="{Binding ProductsKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding ImagesKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding PriceKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding MarginKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
        </UniformGrid>

        <!-- Filtros -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <WrapPanel>
                    <TextBox Width="300" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}"
                             c:Ui.Placeholder="Buscar por nombre, SKU, código o proveedor" Margin="0,0,10,0" />
                    <ComboBox Width="230" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" ToolTip="Categoría (incluye sus subcategorías)"
                              Margin="0,0,10,0" />
                    <ComboBox Width="200" ItemsSource="{Binding States}" SelectedItem="{Binding State}" ToolTip="Estado" Margin="0,0,10,0" />
                    <ComboBox Width="200" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" ToolTip="Ordenar por" />
                </WrapPanel>
            </DockPanel>
            <!-- V4.2 · Plataforma (opciones de la especificación «Plataforma») -->
            <DockPanel Margin="0,10,0,0" Visibility="{Binding HasPlatforms, Converter={StaticResource Visible}}">
                <TextBlock DockPanel.Dock="Left" Text="Plataforma" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,7,10,0" />
                <ItemsControl ItemsSource="{Binding PlatformChips}" Focusable="False" ItemsPanel="{StaticResource WrapPanelTemplate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FilterChip}">
                            <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=OneWay}" Margin="0,0,6,6" Padding="0"
                                         Command="{Binding DataContext.SelectPlatform, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource SurfaceHover}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0" MinWidth="22">
                                        <TextBlock Text="{Binding Count}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <!-- V4.2 · Especificaciones de la categoría elegida (facetas con la cantidad de productos por valor) -->
            <DockPanel Margin="0,6,0,0" Visibility="{Binding HasFacets, Converter={StaticResource Visible}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Quitar filtros técnicos" Command="{Binding ClearTechFilters}"
                        VerticalAlignment="Bottom" Margin="10,0,0,8" Visibility="{Binding HasTechFilters, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Facets}" Focusable="False" ItemsPanel="{StaticResource WrapPanelTemplate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FacetFilter}">
                            <StackPanel Margin="0,0,10,6" Width="176">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" Height="32" ToolTip="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </StackPanel>

        <!-- Galería -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-7,0" Visibility="{Binding IsGallery, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ProductTile}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                              Focusable="False" />
            </ScrollViewer>

            <!-- Lista -->
            <Border Style="{StaticResource CardFlat}" Padding="4,2,4,4" Visibility="{Binding IsList, Converter={StaticResource Visible}}">
                <DataGrid ItemsSource="{Binding Rows}" RowHeight="60">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PRODUCTO" Width="*" MinWidth="260" SortMemberPath="Name" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:CatalogProduct}">
                                    <DockPanel VerticalAlignment="Center">
                                        <c:ProductThumb DockPanel.Dock="Left" Width="46" Height="46" Source="{Binding Image}" CornerRadius="8" />
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Style="{StaticResource Pill}" Padding="6,0">
                                                    <TextBlock Text="{Binding Sku}" Style="{StaticResource Mono}" FontSize="11.5" />
                                                </Border>
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ESTADO" Width="120" SortMemberPath="Status" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:CatalogProduct}">
                                    <c:StatusBadge Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- V4.2 · Serie/IMEI, garantía y plataformas -->
                        <DataGridTemplateColumn Header="FICHA" Width="190" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:CatalogProduct}">
                                    <WrapPanel VerticalAlignment="Center">
                                        <Border Style="{StaticResource Badge}" Margin="0,0,4,2" Visibility="{Binding HasSerialBadge, Converter={StaticResource Visible}}">
                                            <TextBlock Text="{Binding SerialBadge}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Margin="0,0,4,2" Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource Success}"
                                                TextElement.Foreground="{DynamicResource Success}" Visibility="{Binding HasWarrantyBadge, Converter={StaticResource Visible}}">
                                            <TextBlock Text="{Binding WarrantyBadge}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Platforms}" Focusable="False" ItemsPanel="{StaticResource WrapPanelTemplate}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource PlatformBadge}" Margin="0,0,4,2">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding Supplier}" Width="170" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="COSTO" Binding="{Binding CostText}" Width="110" SortMemberPath="Item.UnitCost"
                                            HeaderStyle="{StaticResource HeaderRight}" ElementStyle="{StaticResource CellRight}" />
                        <DataGridTextColumn Header="PRECIO" Binding="{Binding PriceText}" Width="110" SortMemberPath="Price"
                                            HeaderStyle="{StaticResource HeaderRight}" ElementStyle="{StaticResource CellRight}" />
                        <DataGridTextColumn Header="MARGEN" Binding="{Binding MarginText}" Width="90" SortMemberPath="Margin"
                                            HeaderStyle="{StaticResource HeaderRight}" ElementStyle="{StaticResource CellRight}" />
                        <DataGridTextColumn Header="STOCK" Binding="{Binding StockText}" Width="110" SortMemberPath="Stock"
                                            HeaderStyle="{StaticResource HeaderRight}" ElementStyle="{StaticResource CellRight}" />
                        <DataGridTextColumn Header="POSICIÓN" Binding="{Binding BinText}" Width="130" ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Width="84" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:CatalogProduct}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="{x:Static c:Glyphs.Eye}" ToolTip="Ver ficha y kardex"
                                                Command="{Binding DataContext.OpenProduct, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="{x:Static c:Glyphs.Settings}" ToolTip="Editar"
                                                Command="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Search}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Ningún producto coincide con los filtros" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                    <Button Style="{StaticResource LinkButton}" Content="Quitar los filtros" HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding ClearSearch}" />
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- Editor lateral -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource EditorPanel}" Width="450"
                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" DataContext="{Binding Editor}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,16,12,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" Command="{Binding Cancel}" ToolTip="Cerrar sin guardar" />
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                </DockPanel>
                <!-- V4.2 · Pestañas: datos generales y ficha técnica -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceHover}" CornerRadius="10" Padding="2" Margin="20,0,20,6" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="General" c:Ui.Icon="{x:Static c:Glyphs.Tag}" IsChecked="{Binding IsGeneralTab}"
                                     GroupName="editorTab" />
                        <RadioButton Style="{StaticResource Segment}" Content="Ficha técnica" c:Ui.Icon="{x:Static c:Glyphs.Checklist}" IsChecked="{Binding IsTechTab}"
                                     GroupName="editorTab" />
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding SaveText}" Command="{Binding Save}" MinWidth="150"
                                c:Ui.IsBusy="{Binding Save.IsRunning}" c:Ui.Icon="{x:Static c:Glyphs.Save}" />
                        <Button Content="Cancelar" Command="{Binding Cancel}" HorizontalAlignment="Left" />
                    </DockPanel>
                </Border>
                <Grid>
                <!-- V4.2 · Ficha técnica: perfil (serie o IMEI, garantía) y especificaciones de la categoría -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsTechTab, Converter={StaticResource Visible}}">
                    <StackPanel Margin="20,4,20,16">
                        <StackPanel Visibility="{Binding IsLoadingTech, Converter={StaticResource Visible}}" Margin="0,20">
                            <c:ProgressRing Width="30" Height="30" />
                            <TextBlock Text="Leyendo la ficha técnica…" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding TechSheet}" Visibility="{Binding DataContext.HasTechSheet, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource Visible}}"
                                    IsEnabled="{Binding CanEdit}">
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource Switch}" Content="Lleva serie o IMEI (una por unidad)" IsChecked="{Binding TrackSerials}" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,10,0,0"
                                              Visibility="{Binding TrackSerials, Converter={StaticResource Visible}}" ToolTip="Tipo de identificador" />
                                    <TextBlock Text="{Binding SerialHelp}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Text="Meses de garantía" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding WarrantyPresets}" Text="{Binding WarrantyMonths, UpdateSourceTrigger=PropertyChanged}"
                                              Width="120" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding WarrantyText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ESPECIFICACIONES" Style="{StaticResource Overline}" Margin="0,16,0,4" />
                            <TextBlock Text="{Binding FieldsHelp}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SpecField}">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Margin="0,0,8,1" />
                                            <TextBlock Text="{Binding Help}" Style="{StaticResource Caption}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,5" />
                                            <DockPanel Visibility="{Binding IsFree, Converter={StaticResource Visible}}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding HasUnit, Converter={StaticResource Visible}}" />
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="{Binding Placeholder}" MaxLength="300"
                                                         c:Ui.HasError="{Binding Problem, Converter={StaticResource HasValueBool}}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Danger}" FontSize="11.5" Margin="0,3,0,0"
                                                       Visibility="{Binding Problem, Converter={StaticResource HasValue}}" />
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Option}"
                                                      Visibility="{Binding IsOptionSingle, Converter={StaticResource Visible}}" />
                                            <ItemsControl ItemsSource="{Binding Toggles}" Focusable="False" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                                          Visibility="{Binding IsOptionMulti, Converter={StaticResource Visible}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SpecOptionToggle}">
                                                        <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked}" Margin="0,0,14,6" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Style="{StaticResource FormError}" Visibility="{Binding Error, Converter={StaticResource HasValue}}">
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsGeneralTab, Converter={StaticResource Visible}}">
                    <StackPanel Margin="20,4,20,16">
                        <!-- Imagen -->
                        <Grid Height="190">
                            <c:ProductThumb Source="{Binding Image}" Glyph="{x:Static c:Glyphs.Sparkle}" CornerRadius="12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                <Button Style="{StaticResource SoftButton}" Content="Cambiar imagen…" c:Ui.Icon="{x:Static c:Glyphs.Add}" Command="{Binding PickImage}" Height="32" />
                                <Button Content="Quitar" Command="{Binding RemoveImage}" Height="32" Margin="6,0,0,0" c:Ui.Icon="{x:Static c:Glyphs.Delete}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="PNG o JPG. Las fotos grandes se reducen solas (máx. 1 MB)." Style="{StaticResource Caption}" FontSize="11.5" Margin="0,6,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SKU" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="40" c:Ui.Placeholder="CPU-AMD-7600" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" c:Ui.Placeholder="Nombre visible en ventas" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Descripción" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBox Style="{StaticResource MultilineTextBox}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" MinHeight="54"
                                 c:Ui.Placeholder="Modelo, especificaciones clave, compatibilidad…" />

                        <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Add}" Command="{Binding NewCategory}"
                                    ToolTip="Crear una categoría nueva" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Unidad" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Posición en el almacén" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Bins}" SelectedItem="{Binding Bin}" c:Ui.Placeholder="Posición" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Proveedor preferido" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" />

                        <!-- Precio -->
                        <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Costo unitario" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" c:Ui.SelectAllOnFocus="True" c:Ui.Placeholder="0,00"
                                                 c:Ui.Icon="{x:Static c:Glyphs.Money}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Precio de venta (IVA incl.)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" c:Ui.SelectAllOnFocus="True" c:Ui.Placeholder="0,00"
                                                 c:Ui.Icon="{x:Static c:Glyphs.Tag}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <ComboBox ItemsSource="{Binding MarginPresets}" SelectedItem="{Binding MarginPreset}" Margin="0,10,0,0"
                                          ToolTip="Calcula el precio de venta con el margen elegido" c:Ui.Placeholder="Aplicar margen…" />
                                <TextBlock Text="{Binding MarginText}" Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NetPriceText}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Stock mínimo" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" c:Ui.SelectAllOnFocus="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stock máximo" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" c:Ui.SelectAllOnFocus="True" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Código de barras" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Generar" Command="{Binding GenerateBarcode}" Margin="6,0,0,0" c:Ui.Icon="{x:Static c:Glyphs.Barcode}"
                                    ToolTip="Genera un EAN-13 interno válido" />
                            <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" c:Ui.Icon="{x:Static c:Glyphs.Barcode}"
                                     c:Ui.Placeholder="EAN-13, UPC o interno (o léalo con el escáner)" />
                        </DockPanel>
                        <CheckBox Style="{StaticResource Switch}" Content="Producto activo (se vende y aparece en el pedido)" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />

                        <Border Style="{StaticResource FormError}" Visibility="{Binding Error, Converter={StaticResource HasValue}}">
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
