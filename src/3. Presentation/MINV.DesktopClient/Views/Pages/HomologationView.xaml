<UserControl x:Class="MINV.DesktopClient.Views.Pages.HomologationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels"
             xmlns:b="clr-namespace:MINV.Application.Billing;assembly=MINV.Application">
    <!-- V4.1 · Homologación: productos, unidades y medios de pago con sus códigos del SIN -->
    <Grid Margin="28,6,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)"
                    VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,10">
            <ContentControl Content="{Binding PendingKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding DoneKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding UnitsKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding MethodsKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
        </UniformGrid>

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="HomologTab" IsChecked="{Binding IsProductsTab}" Content="Productos" MinWidth="110" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="HomologTab" IsChecked="{Binding IsUnitsTab}" Content="Unidades" MinWidth="110" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="HomologTab" IsChecked="{Binding IsMethodsTab}" Content="Medios de pago" MinWidth="110" />
                </StackPanel>
            </Border>
            <WrapPanel Margin="16,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsProductsTab, Converter={StaticResource Visible}}">
                <TextBox Width="280" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}" Margin="0,0,10,0"
                         c:Ui.Placeholder="Buscar SKU, nombre, categoría o código SIN" />
                <CheckBox Content="Solo pendientes" IsChecked="{Binding OnlyPending}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding CanEdit, Converter={StaticResource Visible}}">
                    <ComboBox Width="250" ItemsSource="{Binding Activities}" SelectedItem="{Binding Activity}" ToolTip="Actividad económica para las sugerencias" Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type b:SiatActivityView}">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Description, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource PrimaryButton}" Content="Sugerir" c:Ui.Icon="{x:Static c:Glyphs.Sparkle}" Command="{Binding Suggest}"
                            ToolTip="Propone el código del SIN de los productos pendientes por palabras del nombre y la categoría" c:Ui.IsBusy="{Binding Suggest.IsRunning}" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <!-- Productos -->
        <Border Grid.Row="3" Style="{StaticResource CardFlat}" Padding="4,2,4,4" Visibility="{Binding IsProductsTab, Converter={StaticResource Visible}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="10,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Button Content="Asignar código del SIN" c:Ui.Icon="{x:Static c:Glyphs.Tag}" Command="{Binding Assign}" HorizontalAlignment="Left"
                            Visibility="{Binding CanEdit, Converter={StaticResource Visible}}" />
                </DockPanel>
                <Grid>
                    <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}" RowHeight="52">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SKU" Width="110" SortMemberPath="Row.Sku" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProductHomologationItem}">
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource BrandSoft}">
                                            <TextBlock Text="{Binding Row.Sku}" Style="{StaticResource Mono}" Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PRODUCTO" Width="*" MinWidth="220" SortMemberPath="Row.Name" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProductHomologationItem}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Row.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Row.Category}" Style="{StaticResource Caption}" FontSize="11.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ACTIVIDAD" Binding="{Binding ActivityText}" Width="100" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="PRODUCTO DEL SIN" Binding="{Binding SinText}" Width="320" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="ESTADO" Width="120" SortMemberPath="IsPending" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProductHomologationItem}">
                                        <Border Style="{StaticResource StatusPill}" c:Ui.BrushKey="{Binding StatusSoftBrush}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" c:Ui.BrushKey="{Binding StatusBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="56" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProductHomologationItem}">
                                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="{x:Static c:Glyphs.Tag}" ToolTip="Asignar código del SIN"
                                                Command="{Binding DataContext.AssignRow, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Tag}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                        <TextBlock Text="Ningún producto coincide con el filtro" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </ContentControl>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Unidades -->
        <Border Grid.Row="3" Style="{StaticResource CardFlat}" Padding="4,2,4,4" Visibility="{Binding IsUnitsTab, Converter={StaticResource Visible}}">
            <DataGrid ItemsSource="{Binding Units}" RowHeight="52">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="UNIDAD DE M-INV" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:UnitHomologationItem}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Row.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Row.Code}" Style="{StaticResource Caption}" FontSize="11.5" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="UNIDAD DE MEDIDA DEL SIN" Width="420">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:UnitHomologationItem}">
                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Height="34" MinHeight="0"
                                          VerticalAlignment="Center" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          c:Ui.HasError="{Binding IsPending}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Medios de pago -->
        <Border Grid.Row="3" Style="{StaticResource CardFlat}" Padding="4,2,4,4" Visibility="{Binding IsMethodsTab, Converter={StaticResource Visible}}">
            <DataGrid ItemsSource="{Binding Methods}" RowHeight="52">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="MEDIO DE PAGO DE M-INV" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:PaymentHomologationItem}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Row.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Row.Code}" Style="{StaticResource Caption}" FontSize="11.5" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="MÉTODO DE PAGO DEL SIN" Width="460">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:PaymentHomologationItem}">
                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Height="34" MinHeight="0"
                                          VerticalAlignment="Center" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          c:Ui.HasError="{Binding IsPending}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
