<UserControl x:Class="MINV.DesktopClient.Views.Pages.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <Grid Margin="28,6,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Exportar" c:Ui.Icon="{x:Static c:Glyphs.Download}" Command="{Binding Export}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Nuevo cliente" c:Ui.Icon="{x:Static c:Glyphs.Add}" Command="{Binding New}" Margin="0,0,8,0"
                        Visibility="{Binding CanEdit, Converter={StaticResource Visible}}" />
                <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="4" Margin="-6,0,-6,10">
            <ContentControl Content="{Binding CustomersKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding BuyersKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding TotalKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding TopKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
        </UniformGrid>

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <WrapPanel>
                <TextBox Width="300" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}"
                         c:Ui.Placeholder="Buscar por nombre, código, NIT, correo o teléfono" Margin="0,0,10,0" />
                <ComboBox Width="230" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" ToolTip="Categoría" Margin="0,0,10,0" />
                <ComboBox Width="200" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" ToolTip="Ordenar por" />
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource CardFlat}" Padding="4,2,4,4">
            <Grid>
                <DataGrid ItemsSource="{Binding Rows}" RowHeight="56" MouseDoubleClick="OnRowDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="CLIENTE" Width="*" MinWidth="260" SortMemberPath="Name" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:CustomerItem}">
                                    <DockPanel VerticalAlignment="Center">
                                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{Binding Name, Converter={StaticResource AvatarBrush}}">
                                            <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TaxText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="CONTACTO" Binding="{Binding Contact}" Width="260" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Category}" Width="160" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="COMPRAS" Binding="{Binding Purchases}" Width="90" HeaderStyle="{StaticResource HeaderRight}" ElementStyle="{StaticResource CellRight}" />
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalText}" Width="130" SortMemberPath="Total" HeaderStyle="{StaticResource HeaderRight}"
                                            ElementStyle="{StaticResource CellRight}" />
                        <DataGridTextColumn Header="ÚLTIMA COMPRA" Binding="{Binding LastText}" Width="120" SortMemberPath="Row.LastPurchase" ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Width="56" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:CustomerItem}">
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="{x:Static c:Glyphs.Settings}" ToolTip="Editar"
                                            Command="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.People}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                    <TextBlock Text="Ningún cliente coincide con la búsqueda" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                </ContentControl>
            </Grid>
        </Border>

        <!-- Editor -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource EditorPanel}" Width="400"
                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}"
                DataContext="{Binding Editor}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,16,12,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" Command="{Binding Cancel}" />
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding Save}" MinWidth="130"
                                c:Ui.IsBusy="{Binding Save.IsRunning}" c:Ui.Icon="{x:Static c:Glyphs.Save}" />
                        <Button Content="Cancelar" Command="{Binding Cancel}" HorizontalAlignment="Left" />
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,4,20,16">
                        <TextBlock Text="Nombre o razón social" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" c:Ui.Icon="{x:Static c:Glyphs.Person}" />
                        <TextBlock Text="NIT / CI" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" c:Ui.Placeholder="Para la factura (opcional)" />
                        <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" />
                        <TextBlock Text="Correo" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" c:Ui.Icon="{x:Static c:Glyphs.Mail}" />
                        <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" c:Ui.Icon="{x:Static c:Glyphs.Phone}" />
                        <CheckBox Style="{StaticResource Switch}" Content="Cliente activo" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />
                        <Border Style="{StaticResource FormError}" Visibility="{Binding Error, Converter={StaticResource HasValue}}">
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
