<UserControl x:Class="MINV.DesktopClient.Views.Pages.FiscalDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <!-- V4.1 · Documentos fiscales: búsqueda, grilla con el estado ante el SIN y detalle con la bitácora y las acciones -->
    <Grid Margin="28,6,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="3" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Hoy" Command="{Binding QuickToday}" Height="32" Padding="12,0" />
                        <Button Style="{StaticResource GhostButton}" Content="7 días" Command="{Binding QuickWeek}" Height="32" Padding="12,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Mes" Command="{Binding QuickMonth}" Height="32" Padding="12,0" />
                    </StackPanel>
                </Border>
                <ComboBox Width="190" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" ToolTip="Período (fecha fiscal de emisión)" Margin="0,0,8,0" />
                <Button Content="Exportar CSV" c:Ui.Icon="{x:Static c:Glyphs.Download}" Command="{Binding Export}" Margin="0,0,8,0"
                        ToolTip="Los documentos que muestra la lista, con sus filtros, en un archivo para Excel" />
                <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="4" Margin="-6,0,-6,10">
            <ContentControl Content="{Binding DocumentsKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding ValidKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding PendingKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding VoidedKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
        </UniformGrid>

        <!-- Filtros: caben en una fila también con el detalle abierto; el resumen pasa a la línea siguiente si no hay lugar -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBox Width="280" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}" Margin="0,0,10,4"
                     c:Ui.Placeholder="N°, CUF, NIT / CI o nombre" ToolTip="Buscar por número, CUF, NIT / CI o nombre del comprador"
                     AutomationProperties.Name="Buscar documentos" />
            <ComboBox Width="170" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" ToolTip="Estado ante el SIN" Margin="0,0,10,4"
                      AutomationProperties.Name="Estado" />
            <ComboBox Width="170" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" ToolTip="Tipo de documento" Margin="0,0,10,4"
                      AutomationProperties.Name="Tipo de documento" />
            <!-- V7 · Sucursal, punto de venta y tipo de emisión en listas desplegables -->
            <ComboBox Width="170" ItemsSource="{Binding Branches}" SelectedItem="{Binding Branch}" ToolTip="Sucursal" Margin="0,0,10,4"
                      AutomationProperties.Name="Sucursal" />
            <ComboBox Width="180" ItemsSource="{Binding PointsOfSale}" SelectedItem="{Binding PointOfSale}" ToolTip="Punto de venta" Margin="0,0,10,4"
                      AutomationProperties.Name="Punto de venta" />
            <ComboBox Width="190" ItemsSource="{Binding Emissions}" SelectedItem="{Binding Emission}" ToolTip="Tipo de emisión" Margin="0,0,10,4"
                      AutomationProperties.Name="Tipo de emisión" />
            <Button Style="{StaticResource GhostButton}" Content="Limpiar filtros" c:Ui.Icon="{x:Static c:Glyphs.ClearFilter}" Command="{Binding ClearFilters}"
                    Margin="0,0,14,4" Visibility="{Binding HasFilters, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,4" />
        </WrapPanel>

        <Border Grid.Row="3" Style="{StaticResource CardFlat}" Padding="4,2,4,4">
            <Grid>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" RowHeight="54">
                    <DataGrid.Columns>
                        <!-- Columnas compactas: con el detalle abierto la grilla mide ~650 px y nada se corta -->
                        <DataGridTemplateColumn Header="N°" Width="104" SortMemberPath="Number" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FiscalDocumentItem}">
                                    <Border Style="{StaticResource Pill}" Background="{DynamicResource BrandSoft}" ToolTip="{Binding KindText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding KindGlyph}" FontSize="11" Foreground="{DynamicResource BrandText}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding NumberText}" Style="{StaticResource Mono}" Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="FECHA · LUGAR" Width="142" SortMemberPath="IssuedAt" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FiscalDocumentItem}">
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding IssuedText}">
                                        <TextBlock Text="{Binding DateText}" />
                                        <TextBlock Text="{Binding TimePlaceText}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="COMPRADOR" Width="*" MinWidth="150" SortMemberPath="BuyerName" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FiscalDocumentItem}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BuyerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding BuyerDocument, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SaleText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalText}" Width="112" SortMemberPath="Total" HeaderStyle="{StaticResource HeaderRight}"
                                            ElementStyle="{StaticResource CellRight}" />
                        <DataGridTemplateColumn Header="ESTADO · CUF" Width="150" SortMemberPath="Status" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FiscalDocumentItem}">
                                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource StatusPill}" c:Ui.BrushKey="{Binding StatusSoftBrush}" ToolTip="{Binding StatusHelp}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" c:Ui.BrushKey="{Binding StatusBrush}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Offline}" FontSize="13" Margin="6,0,0,0" Foreground="{DynamicResource Info}"
                                                       ToolTip="Emitido fuera de línea (tipo de emisión 2)" Visibility="{Binding IsOffline, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ShortCuf}" Style="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"
                                                   ToolTip="{Binding Row.Cuf}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Invoice}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="No hay documentos fiscales con ese filtro" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="Pruebe otro período o quite la búsqueda. Las facturas nacen en la caja al cobrar." Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Border>

        <!-- Detalle -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource EditorPanel}" Width="450"
                Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
            <DockPanel Margin="20,16,14,14">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,6,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" Click="OnCloseDetail" ToolTip="Cerrar" />
                        <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Selected.KindText, Mode=OneWay}" /> <Run Text="N°" /> <Run Text="{Binding Selected.NumberText, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource StatusPill}" c:Ui.BrushKey="{Binding Selected.StatusSoftBrush}">
                            <TextBlock Text="{Binding Selected.StatusText}" FontSize="11.5" FontWeight="SemiBold" c:Ui.BrushKey="{Binding Selected.StatusBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Selected.IssuedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding Selected.PlaceText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusHelp}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Acciones -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,6,0">
                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10" />
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource SoftButton}" Content="Imprimir rollo" c:Ui.Icon="{x:Static c:Glyphs.Printer}" Command="{Binding PrintRoll}"
                                Height="34" Padding="8,0" Margin="0,0,4,6" c:Ui.IsBusy="{Binding PrintRoll.IsRunning}" />
                        <Button Content="Ver PDF" c:Ui.Icon="{x:Static c:Glyphs.Invoice}" Command="{Binding ViewPdf}" Height="34" Padding="8,0" Margin="2,0,2,6"
                                c:Ui.IsBusy="{Binding ViewPdf.IsRunning}" />
                        <Button Content="Correo" c:Ui.Icon="{x:Static c:Glyphs.Mail}" Command="{Binding SendEmail}" Height="34" Padding="8,0" Margin="4,0,0,6"
                                ToolTip="Enviar el XML y el PDF al comprador" c:Ui.IsBusy="{Binding SendEmail.IsRunning}" />
                        <Button Content="Verificar SIN" c:Ui.Icon="{x:Static c:Glyphs.Shield}" Command="{Binding Verify}" Height="34" Padding="8,0" Margin="0,0,4,6"
                                ToolTip="Consultar el estado del documento en el SIN" c:Ui.IsBusy="{Binding Verify.IsRunning}" />
                        <Button Content="Ver XML" c:Ui.Icon="{x:Static c:Glyphs.Code}" Command="{Binding ShowXml}" Height="34" Padding="8,0" Margin="2,0,2,6" />
                        <Button Content="Re-emitir" c:Ui.Icon="{x:Static c:Glyphs.Refresh}" Command="{Binding Reissue}" Height="34" Padding="8,0" Margin="4,0,0,6"
                                ToolTip="Documento nuevo para la misma venta (tras un rechazo o una anulación)" Visibility="{Binding CanIssue, Converter={StaticResource Visible}}" />
                    </UniformGrid>
                    <UniformGrid Columns="3" Visibility="{Binding CanVoidDocuments, Converter={StaticResource Visible}}">
                        <Button Style="{StaticResource DangerButton}" Content="Anular" c:Ui.Icon="{x:Static c:Glyphs.Error}" Command="{Binding Void}" Height="34" Padding="8,0"
                                Margin="0,0,4,0" c:Ui.IsBusy="{Binding Void.IsRunning}" />
                        <Button Content="Revertir" c:Ui.Icon="{x:Static c:Glyphs.Undo}" Command="{Binding Revert}" Height="34" Padding="8,0" Margin="2,0"
                                ToolTip="Revertir la anulación (una sola vez, dentro del plazo)" c:Ui.IsBusy="{Binding Revert.IsRunning}" />
                        <Button Content="Devolución" c:Ui.Icon="{x:Static c:Glyphs.Undo}" Command="{Binding CreditNote}" Height="34" Padding="8,0" Margin="4,0,0,0"
                                ToolTip="Devolución de mercadería con nota crédito-débito" c:Ui.IsBusy="{Binding CreditNote.IsRunning}" />
                    </UniformGrid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- CUF -->
                        <Border Style="{StaticResource Panel}" Padding="12,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="{x:Static c:Glyphs.Copy}"
                                        Command="{Binding CopyCuf}" ToolTip="Copiar el CUF" VerticalAlignment="Top" />
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="CÓDIGO ÚNICO DE FACTURA (CUF)" Style="{StaticResource Overline}" />
                                    <TextBlock Text="{Binding CufText}" Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,12,0,0">
                            <Border DockPanel.Dock="Right" Width="116" Height="116" CornerRadius="6" ClipToBounds="True" Margin="10,0,0,0" VerticalAlignment="Top"
                                    ToolTip="QR de consulta del documento en el SIN" Visibility="{Binding QrUrl, Converter={StaticResource HasValue}}">
                                <c:QrCode Text="{Binding QrUrl}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="COMPRADOR" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding BuyerText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,8" />
                                <TextBlock Text="PAGO Y EMISIÓN" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding PaymentText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding EmissionText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DeadlineText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding DeadlineText, Converter={StaticResource HasValue}}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource FormError}" Visibility="{Binding HasRejection, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="MENSAJES DEL SIN" Style="{StaticResource Overline}" Foreground="{DynamicResource Danger}" />
                                <TextBlock Text="{Binding RejectionText}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Padding="12,8" Margin="0,10,0,0" Visibility="{Binding HasVoidReason, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding VoidReasonText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                        </Border>
                        <Border Style="{StaticResource Panel}" Padding="12,8" Margin="0,10,0,0" Visibility="{Binding HasOriginal, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding OriginalText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource LinkButton}" Content="Ver el documento que reemplaza" Command="{Binding OpenRelated}" CommandParameter="replaces"
                                    Visibility="{Binding HasReplaces, Converter={StaticResource Visible}}" Margin="0,0,14,0" />
                            <Button Style="{StaticResource LinkButton}" Content="Ver el documento que lo reemplazó" Command="{Binding OpenRelated}" CommandParameter="replacedBy"
                                    Visibility="{Binding HasReplacedBy, Converter={StaticResource Visible}}" />
                        </StackPanel>

                        <!-- Líneas y totales -->
                        <TextBlock Text="DETALLE" Style="{StaticResource Overline}" Margin="0,12,0,2" />
                        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FiscalLineItem}">
                                    <DockPanel Margin="0,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalText}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="8,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,6" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalText}" />
                            <TextBlock Text="Subtotal" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <DockPanel Visibility="{Binding HasDiscount, Converter={StaticResource Visible}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DiscountText}" />
                            <TextBlock Text="Descuento adicional" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalsText}" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TaxText}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="IVA 13 % (crédito / débito fiscal)" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Detail.Legend}" Style="{StaticResource Caption}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,10,0,0" />

                        <!-- Bitácora del SIN -->
                        <TextBlock Text="BITÁCORA DEL SIN" Style="{StaticResource Overline}" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FiscalEventItem}">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="2" Background="{DynamicResource Border}" HorizontalAlignment="Center" />
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0" c:Ui.BrushKey="{Binding Brush}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,10">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" FontSize="11.5" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       Visibility="{Binding Description, Converter={StaticResource HasValue}}" />
                                            <TextBlock Text="{Binding Reception}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                                       Visibility="{Binding Reception, Converter={StaticResource HasValue}}" />
                                            <TextBlock Text="{Binding Messages}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Danger}"
                                                       Visibility="{Binding Messages, Converter={StaticResource HasValue}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Entregas -->
                        <StackPanel Visibility="{Binding HasDeliveries, Converter={StaticResource Visible}}">
                            <TextBlock Text="ENTREGAS AL COMPRADOR" Style="{StaticResource Overline}" Margin="0,8,0,4" />
                            <ItemsControl ItemsSource="{Binding Deliveries}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FiscalDeliveryItem}">
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ResultText}" FontSize="12" c:Ui.BrushKey="{Binding Brush}" Margin="8,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" FontSize="11.5" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
