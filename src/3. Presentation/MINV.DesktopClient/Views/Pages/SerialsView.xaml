<UserControl x:Class="MINV.DesktopClient.Views.Pages.SerialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <!-- V4.2 · Series e IMEI: búsqueda, estado y sucursal; trazabilidad (línea de tiempo), garantía derivada y casos RMA -->
    <Grid Margin="28,6,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Exportar CSV" c:Ui.Icon="{x:Static c:Glyphs.Download}" Command="{Binding Export}" Margin="0,0,8,0"
                        ToolTip="Las series que muestra la lista, con sus filtros, en un archivo para Excel" />
                <Button Content="Registrar series de stock" c:Ui.Icon="{x:Static c:Glyphs.Barcode}" Command="{Binding RegisterStock}" Margin="0,0,8,0"
                        c:Ui.IsBusy="{Binding RegisterStock.IsRunning}" Visibility="{Binding CanManage, Converter={StaticResource Visible}}"
                        ToolTip="Series de unidades que ya estaban en stock sin serie (inventario inicial)" />
                <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="4" Margin="-6,0,-6,10">
            <ContentControl Content="{Binding InStockKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding SoldKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding RmaKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding OutKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
        </UniformGrid>

        <DockPanel Grid.Row="2" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,8" />
            <WrapPanel>
                <TextBox Width="340" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Icon="{x:Static c:Glyphs.Search}"
                         c:Ui.Placeholder="Serie, IMEI o SKU (o léalo con el escáner)" Margin="0,0,10,8" AutomationProperties.Name="Buscar" />
                <ComboBox Width="220" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" ToolTip="Estado" Margin="0,0,10,8"
                          AutomationProperties.Name="Estado" />
                <ComboBox Width="200" ItemsSource="{Binding Branches}" SelectedItem="{Binding Branch}" ToolTip="Sucursal" Margin="0,0,10,8"
                          AutomationProperties.Name="Sucursal" />
                <ComboBox Width="210" ItemsSource="{Binding Warranties}" SelectedItem="{Binding Warranty}" ToolTip="Garantía" Margin="0,0,10,8"
                          AutomationProperties.Name="Garantía" />
                <!-- V7 · «Limpiar filtros» a la vista (antes solo aparecía cuando la lista quedaba vacía) -->
                <Button Style="{StaticResource GhostButton}" Content="Limpiar filtros" c:Ui.Icon="{x:Static c:Glyphs.ClearFilter}" Command="{Binding ClearFilters}"
                        Margin="0,0,10,8" Visibility="{Binding HasFilters, Converter={StaticResource Visible}}" />
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource CardFlat}" Padding="4,2,4,4">
            <Grid>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" RowHeight="54">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="SERIE / IMEI" Width="160" SortMemberPath="Serial" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:SerialItem}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Serial}" Style="{StaticResource Mono}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource Badge}" Padding="6,0" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding KindBadge}" FontSize="10" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PRODUCTO" Width="1.5*" MinWidth="130" SortMemberPath="Product" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:SerialItem}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Product}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5">
                                            <Run Text="{Binding Sku, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Location, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="VENTA" Width="*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:SerialItem}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SoldText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CustomerText}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="GARANTÍA" Width="135" SortMemberPath="WarrantyUntil" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:SerialItem}">
                                    <TextBlock Text="{Binding WarrantyText}" c:Ui.BrushKey="{Binding WarrantyBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ESTADO" Width="145" SortMemberPath="Status" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:SerialItem}">
                                    <Border Style="{StaticResource StatusPill}" c:Ui.BrushKey="{Binding StatusSoftBrush}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" c:Ui.BrushKey="{Binding StatusBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Barcode}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="Las series entran al recibir compras, en el saldo inicial o con «Registrar series de stock»." Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="Quitar los filtros" HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding ClearFilters}"
                                Visibility="{Binding HasFilters, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Border>

        <!-- Trazabilidad -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource EditorPanel}" Width="380"
                Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
            <DockPanel Margin="20,16">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" ToolTip="Cerrar"
                                Click="OnClose" />
                        <TextBlock Text="{Binding Selected.Serial}" Style="{StaticResource H2}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Selected.Product}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource StatusPill}" c:Ui.BrushKey="{Binding Selected.StatusSoftBrush}">
                            <TextBlock Text="{Binding Selected.StatusText}" FontSize="11" FontWeight="SemiBold" c:Ui.BrushKey="{Binding Selected.StatusBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Selected.Location}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border CornerRadius="10" Padding="12,9" Margin="0,12,0,0" c:Ui.BrushKey="{Binding WarrantySoftBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Shield}" FontSize="18" Margin="0,0,10,0"
                                       c:Ui.BrushKey="{Binding WarrantyBrush}" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding WarrantyTitle}" FontWeight="SemiBold" c:Ui.BrushKey="{Binding WarrantyBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WarrantyDetail}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding SaleText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding OriginText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding OriginText, Converter={StaticResource HasValue}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,10" />
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource PrimaryButton}" Content="Abrir RMA" c:Ui.Icon="{x:Static c:Glyphs.Shield}" Command="{Binding OpenClaim}" Margin="0,0,4,0"
                                Padding="8,0" ToolTip="Abrir un caso de garantía con esta unidad" />
                        <Button Content="Ficha" c:Ui.Icon="{x:Static c:Glyphs.Eye}" Command="{Binding OpenProduct}" Margin="2,0" Padding="8,0" />
                        <Button Content="Dar destino" c:Ui.Icon="{x:Static c:Glyphs.Delete}" Command="{Binding DisposeUnit}" Margin="4,0,0,0" Padding="8,0"
                                ToolTip="Devolver al proveedor o dar de baja una unidad devuelta o en garantía" />
                    </UniformGrid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasClaims, Converter={StaticResource Visible}}" Margin="0,0,0,12">
                            <TextBlock Text="CASOS RMA" Style="{StaticResource Overline}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Claims}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WarrantyClaimItem}">
                                        <DockPanel Margin="0,4">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}" c:Ui.BrushKey="{Binding StatusSoftBrush}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" c:Ui.BrushKey="{Binding StatusBrush}" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Number}" Style="{StaticResource Mono}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Issue}" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="TRAZABILIDAD" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                        <c:ProgressRing Width="26" Height="26" Visibility="{Binding IsLoadingTrace, Converter={StaticResource Visible}}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SerialEventItem}">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Línea de tiempo: burbuja del hecho y línea vertical -->
                                        <Border Width="2" Background="{DynamicResource Border}" HorizontalAlignment="Center" Margin="0,28,0,0" />
                                        <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top" c:Ui.BrushKey="{Binding SoftBrush}">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" c:Ui.BrushKey="{Binding Brush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,3,0,12">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap">
                                                <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
