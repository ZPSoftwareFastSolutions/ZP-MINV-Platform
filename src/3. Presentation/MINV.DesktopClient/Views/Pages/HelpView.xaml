<UserControl x:Class="MINV.DesktopClient.Views.Pages.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,6,28,28">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Guides}" Focusable="False" Margin="-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HelpGuide}">
                        <Border Style="{StaticResource Card}" Margin="8">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconBubble}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                                        <TextBlock Text="{Binding Role}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="0,14,0,0" AlternationCount="100">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource BrandSoft}" VerticalAlignment="Top">
                                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandText}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource StepNumber}}" />
                                                </Border>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="10,2,0,0" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Atajos de teclado" Style="{StaticResource H3}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Shortcuts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HelpEntry}">
                                    <DockPanel Margin="0,5">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource KeyCap}" MinWidth="120" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="El semáforo del stock" Style="{StaticResource H3}" />
                        <TextBlock Text="Las mismas reglas de la V2.1: dependen del stock, del mínimo, del máximo y del margen de alerta." Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,3,0,10" />
                        <ItemsControl ItemsSource="{Binding Legend}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StatusMeaning}">
                                    <DockPanel Margin="0,5">
                                        <Grid DockPanel.Dock="Left" Width="130">
                                            <c:StatusBadge Status="{Binding Status}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Action}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Run Text="M-INV" /> <Run Text="{Binding Version, Mode=OneWay}" /> <Run Text="· guía completa en docs/deployment/inicio-rapido-v3.md" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
