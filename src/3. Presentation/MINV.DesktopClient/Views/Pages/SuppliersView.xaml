<UserControl x:Class="MINV.DesktopClient.Views.Pages.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <Grid Margin="28,6,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Órdenes de compra" c:Ui.Icon="{x:Static c:Glyphs.Clipboard}" Command="{Binding NewOrder}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Nuevo proveedor" c:Ui.Icon="{x:Static c:Glyphs.Add}" Command="{Binding New}" Margin="0,0,8,0"
                        Visibility="{Binding CanEdit, Converter={StaticResource Visible}}" />
                <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="4" Margin="-6,0,-6,10">
            <ContentControl Content="{Binding SuppliersKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding OpenKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding PurchasedKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
            <ContentControl Content="{Binding LeadKpi}" ContentTemplate="{StaticResource KpiTemplate}" Focusable="False" />
        </UniformGrid>

        <TextBox Grid.Row="2" Width="340" HorizontalAlignment="Left" Margin="0,0,0,12" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 c:Ui.Icon="{x:Static c:Glyphs.Search}" c:Ui.Placeholder="Buscar proveedor o contacto" />

        <Border Grid.Row="3" Style="{StaticResource CardFlat}" Padding="4,2,4,4">
            <DataGrid ItemsSource="{Binding Rows}" RowHeight="58">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="PROVEEDOR" Width="*" MinWidth="260" SortMemberPath="Name" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:SupplierItem}">
                                <DockPanel VerticalAlignment="Center">
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Background="{Binding Name, Converter={StaticResource AvatarBrush}}">
                                        <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Contact}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" Width="100" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="ENTREGA" Binding="{Binding LeadText}" Width="90" SortMemberPath="Row.LeadTimeDays" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="PRODUCTOS" Binding="{Binding Products}" Width="100" HeaderStyle="{StaticResource HeaderRight}" ElementStyle="{StaticResource CellRight}" />
                    <DataGridTextColumn Header="ÓRDENES ABIERTAS" Binding="{Binding OpenOrders}" Width="140" HeaderStyle="{StaticResource HeaderRight}"
                                        ElementStyle="{StaticResource CellRight}" />
                    <DataGridTextColumn Header="COMPRADO" Binding="{Binding PurchasedText}" Width="140" SortMemberPath="Purchased" HeaderStyle="{StaticResource HeaderRight}"
                                        ElementStyle="{StaticResource CellRight}" />
                    <DataGridTemplateColumn Width="56" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:SupplierItem}">
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="{x:Static c:Glyphs.Settings}" ToolTip="Editar"
                                        Command="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource EditorPanel}" Width="400"
                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}"
                DataContext="{Binding Editor}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,16,12,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Close}" Command="{Binding Cancel}" />
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding Save}" MinWidth="130"
                                c:Ui.IsBusy="{Binding Save.IsRunning}" c:Ui.Icon="{x:Static c:Glyphs.Save}" />
                        <Button Content="Cancelar" Command="{Binding Cancel}" HorizontalAlignment="Left" />
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,4,20,16">
                        <TextBlock Text="Razón social" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" c:Ui.Icon="{x:Static c:Glyphs.Briefcase}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NIT" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Días de entrega" Style="{StaticResource FieldLabel}" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding LeadOptions}" Text="{Binding LeadTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Contacto" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" c:Ui.Icon="{x:Static c:Glyphs.Person}" />
                        <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" c:Ui.Icon="{x:Static c:Glyphs.Phone}" />
                        <TextBlock Text="Correo" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" c:Ui.Icon="{x:Static c:Glyphs.Mail}" />
                        <CheckBox Style="{StaticResource Switch}" Content="Proveedor activo" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />
                        <Border Style="{StaticResource FormError}" Visibility="{Binding Error, Converter={StaticResource HasValue}}">
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
