<UserControl x:Class="MINV.DesktopClient.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MINV.DesktopClient.Controls"
             xmlns:vm="clr-namespace:MINV.DesktopClient.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,6,28,28">
            <!-- Encabezado -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="Registrar entrada" c:Ui.Icon="{x:Static c:Glyphs.Add}" Command="{Binding NewEntry}"
                            Visibility="{Binding CanRegisterEntries, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
                    <Button Content="Registrar salida" c:Ui.Icon="{x:Static c:Glyphs.Export}" Command="{Binding NewIssue}"
                            Visibility="{Binding CanRegisterIssues, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Refresh}" Command="{Binding Refresh}" ToolTip="Actualizar (F5)" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Próximo paso -->
            <Border Background="{DynamicResource BrandSoft}" CornerRadius="12" Padding="16,12" Margin="0,0,0,18">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Surface}">
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Bulb}" Foreground="{DynamicResource BrandText}" />
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver alertas" VerticalAlignment="Center"
                            Command="{Binding Go}" CommandParameter="alertas" Margin="12,0,4,0" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Próximo paso" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" FontSize="12" />
                        <TextBlock Text="{Binding NextStep}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Indicadores -->
            <UniformGrid Columns="4" Margin="-8,0,-8,0">
                <Button Style="{StaticResource CardButton}" Margin="8" Command="{Binding Go}" CommandParameter="stock" ToolTip="{Binding InventoryValueFull}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource IconBubble}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Money}" FontSize="18" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Valor del inventario" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InventoryValue}" Style="{StaticResource Kpi}" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding ActiveProductsText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="8" Command="{Binding Go}" CommandParameter="alertas">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource IconBubble}" Background="{DynamicResource WarningSoft}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Warning}" FontSize="18" Foreground="{DynamicResource Warning}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Alertas de stock" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AlertCount}" Style="{StaticResource Kpi}" Margin="0,8,0,4" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{Binding OutOfStock, Mode=OneWay}" Foreground="{DynamicResource StatusOutOfStock}" FontWeight="SemiBold" />
                                <Run Text="agotados ·" />
                                <Run Text="{Binding BelowMinimum, Mode=OneWay}" Foreground="{DynamicResource StatusCritical}" FontWeight="SemiBold" />
                                <Run Text="bajo mínimo" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="8" Command="{Binding Go}" CommandParameter="pedido">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource IconBubble}" Background="{DynamicResource InfoSoft}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Cart}" FontSize="18" Foreground="{DynamicResource Info}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Pedido sugerido" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OrderTotal}" Style="{StaticResource Kpi}" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding OrderDetail}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="8" Command="{Binding Go}" CommandParameter="stock">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource IconBubble}" Background="{DynamicResource SuccessSoft}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static c:Glyphs.Swap}" FontSize="18" Foreground="{DynamicResource Success}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Movimientos de hoy" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TodayMovements}" Style="{StaticResource Kpi}" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding TodayDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Button>
            </UniformGrid>

            <!-- Gráficos -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource ChartEntries}" VerticalAlignment="Center" />
                                <TextBlock Text="Entradas" Style="{StaticResource Caption}" Margin="6,0,14,0" />
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource ChartIssues}" VerticalAlignment="Center" />
                                <TextBlock Text="Salidas" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Entradas y salidas · últimos 14 días" Style="{StaticResource H3}" />
                                <TextBlock Text="{Binding TrendSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <c:ColumnChart Points="{Binding Trend}" Height="236" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Estado del inventario" Style="{StaticResource H3}" />
                            <TextBlock Text="Semáforo por producto · clic para filtrar" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="160" Height="160" VerticalAlignment="Center">
                                <c:DonutChart Segments="{Binding StatusSegments}" Stroke="20" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveProducts}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="activos" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Legend}" VerticalAlignment="Center" Margin="12,0,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LegendItem}">
                                        <Button Style="{StaticResource RowButton}" Padding="6,5"
                                                Command="{Binding DataContext.FilterStock, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                <Ellipse Width="9" Height="9" c:Ui.BrushKey="{Binding BrushKey}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" Margin="9,0,0,0" Foreground="{DynamicResource TextSecondary}" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Listas -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="18,18,18,10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver todas" Command="{Binding Go}"
                                    CommandParameter="alertas" VerticalAlignment="Center" />
                            <TextBlock Text="Alertas urgentes" Style="{StaticResource H3}" />
                        </DockPanel>
                        <Grid>
                            <ItemsControl ItemsSource="{Binding UrgentAlerts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AlertItem}">
                                        <Button Style="{StaticResource RowButton}" Padding="6,7"
                                                Command="{Binding DataContext.OpenProduct, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Sku}">
                                            <DockPanel>
                                                <c:StatusBadge DockPanel.Dock="Right" Status="{Binding Status}" Margin="8,0,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding StockText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MinimumText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.CheckCircle}" Content="Sin alertas: todo en orden"
                                            Visibility="{Binding UrgentAlerts.Count, Converter={StaticResource NoValue}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,18,18,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Más vendidos" Style="{StaticResource H3}" />
                            <TextBlock Text="Salidas por venta de los últimos 30 días" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Grid>
                            <ItemsControl ItemsSource="{Binding TopSellers}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TopSellerItem}">
                                        <Button Style="{StaticResource RowButton}" Padding="6,7"
                                                Command="{Binding DataContext.OpenProduct, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Sku}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource BrandSoft}"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Rank}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrandText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="10,0,0,0">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SalesText}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <c:LevelBar Value="{Binding Share}" Height="5" Margin="0,6,0,0" Foreground="{DynamicResource ChartEntries}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Chart}" Content="Sin ventas en los últimos 30 días"
                                            Visibility="{Binding TopSellers.Count, Converter={StaticResource NoValue}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,18,18,10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver stock" Command="{Binding Go}"
                                    CommandParameter="stock" VerticalAlignment="Center" />
                            <TextBlock Text="Últimos movimientos" Style="{StaticResource H3}" />
                        </DockPanel>
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource MovementRow}" Focusable="False" />
                            <ContentControl Style="{StaticResource EmptyState}" Tag="{x:Static c:Glyphs.Swap}" Content="Todavía no hay movimientos"
                                            Visibility="{Binding Recent.Count, Converter={StaticResource NoValue}}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Actividad -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18,20,10"
                    Visibility="{Binding CanSeeActivity, Converter={StaticResource Visible}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver toda la actividad" Command="{Binding Go}"
                                CommandParameter="actividad" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Actividad reciente" Style="{StaticResource H3}" />
                            <TextBlock Text="Auditoría inmutable: cada operación queda registrada, también las rechazadas" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Activity}" ItemTemplate="{StaticResource ActivityRow}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,24,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
