<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cliente de escritorio nativo (WPF / XAML / MVVM). El ejecutable se llama M-INV.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(MinvTargetFramework)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MINV.DesktopClient</RootNamespace>
    <AssemblyName>M-INV</AssemblyName>
    <AssemblyTitle>M-INV · Cliente de escritorio</AssemblyTitle>
    <ApplicationIcon>Assets\minv.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\2. Infrastructure\MINV.Infrastructure\MINV.Infrastructure.csproj" />
    <ProjectReference Include="..\..\2. Infrastructure\MINV.Hardware\MINV.Hardware.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\minv.ico" />
    <Resource Include="Assets\minv-256.png" />
    <!-- V4.2 · Logotipo de la edición Tecnología (pantalla de carga e inicio de sesión) -->
    <Resource Include="Assets\minv-logotipo.png" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- V4.2 · La demostración genera Tech Zone Gaming en memoria (LocalDataSeeder): ya no copia el libro de la V2.1. -->
  </ItemGroup>
</Project>
