<Application x:Class="MINV.DesktopClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- La paleta (posición 0) se reemplaza al cambiar el tema: ThemeService (V4.2: oscuro por defecto) -->
                <ResourceDictionary Source="Theme/Palette.Dark.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
                <ResourceDictionary Source="Views/Shared.xaml" />
                <!-- V4.1 · Facturación SIAT: datos del comprador y formularios modales -->
                <ResourceDictionary Source="Views/BillingForms.xaml" />
                <!-- V4.2 · Edición Tecnología: series e IMEI, especificaciones, casos RMA y cotizaciones del armador -->
                <ResourceDictionary Source="Views/TechForms.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
