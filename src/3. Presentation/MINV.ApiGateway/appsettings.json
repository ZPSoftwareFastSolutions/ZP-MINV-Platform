{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Minv": {
    "Storage": "postgres",
    "Webhooks": {
      "Enabled": true,
      "IntervalSeconds": 5,
      "AllowPrivateTargets": false
    },
    "Reporting": {
      "Enabled": true,
      "RefreshMinutes": 5
    },
    "Storefront": {
      "Enabled": true,
      "TenantCode": "TECHZONE",
      "BranchCode": "CM",
      "AllowedOrigins": [ "http://localhost:5173" ],
      "ReservationHours": 48,
      "ReadsPerMinute": 300,
      "ReservationsPerMinute": 10,
      "ExpiryMinutes": 5
    }
  }
}
