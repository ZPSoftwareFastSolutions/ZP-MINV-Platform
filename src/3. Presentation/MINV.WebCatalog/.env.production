# Valores de `npm run build` (vite build). Cámbielos por la URL pública del gateway antes de publicar el sitio; la
# variable de entorno VITE_API_URL, si existe al construir (deploy/Dockerfile.webcatalog la recibe como ARG), tiene
# prioridad sobre este archivo. Detalle de cada variable: .env.example
VITE_API_URL=http://localhost:5090
